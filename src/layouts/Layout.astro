---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Shamsiddinov Muxiddin | Full-Stack Dasturchi & IT Pedagog",
  description = "Shamsiddinov Muxiddin Xusniddin o‘g‘li — Full-Stack Web Dasturchi, Aiogram 3 Bot Dasturchi va IT Pedagog. Rich Boss xususiy maktabi ustozi, GDPI talabasi.",
} = Astro.props;

import Preloader from "../components/Preloader.astro";
import BackgroundEffect from "../components/BackgroundEffect.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteUrl = "https://muxiddin-darkcode.github.io";
---

<!doctype html>
<html lang="uz" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}/favicon.png`} />
    <link rel="canonical" href={siteUrl} />

    <!-- Google Fonts: Aldrich, Space Grotesk & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Aldrich&family=JetBrains+Mono:ital,wght@0,300..800;1,300..800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Telegram / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${baseUrl}/images/avatar.jpg`} />
    <meta property="og:site_name" content="Shamsiddinov Muxiddin Portfolio" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}/images/avatar.jpg`} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Shamsiddinov Muxiddin Xusniddin o‘g‘li",
        "alternateName": "Muxiddin-darkcode",
        "jobTitle": "IT Mutaxassisi, Web Developer, Telegram Bot Developer, IT Educator",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Guliston",
          "addressRegion": "Sirdaryo",
          "addressCountry": "O‘zbekiston"
        },
        "worksFor": {
          "@type": "Organization",
          "name": "Rich Boss xususiy maktabi"
        },
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "Guliston davlat pedagogika instituti"
        },
        "sameAs": [
          "https://github.com/Muxiddin-darkcode"
        ]
      }
    </script>
  </head>
  <body class="bg-[#040404] text-slate-100 font-sans min-h-screen selection:bg-[#4EEDB8] selection:text-[#02130c] relative overflow-x-hidden antialiased w-full">
    <!-- Futuristic Cyber Preloader (1.15s) -->
    <Preloader />
    
    <!-- Top Scroll Progress -->
    <div id="scroll-progress" class="fixed top-0 left-0 h-[2.5px] bg-gradient-to-r from-[#00F5A0] via-[#4EEDB8] to-[#5FFEC4] z-[100] transition-all duration-75 w-0 shadow-[0_0_12px_#4EEDB8]"></div>

    <!-- Soddaroq va nafis orqa fon animatsiyasi (Luminous Particles + Breathing Auroras) -->
    <BackgroundEffect />

    <!-- Main Container -->
    <div class="mx-auto max-w-6xl px-3 sm:px-6 lg:px-8 relative z-10 w-full overflow-x-hidden sm:overflow-x-visible">
      <slot />
    </div>

    <script is:inline>
      // Scroll Progress Bar
      window.addEventListener("scroll", () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        const progressEl = document.getElementById("scroll-progress");
        if (progressEl) progressEl.style.width = scrollPercent + "%";
      }, { passive: true });
    </script>

    <!-- Bundled GSAP Animation Initialization -->
    <script>
      import { initGsapAnimations } from "../scripts/gsapAnimations";

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => initGsapAnimations());
      } else {
        initGsapAnimations();
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-base: #040404;
    --bg-card: rgba(12, 20, 29, 0.75);
    --border-cyber: rgba(78, 237, 184, 0.18);
    --border-cyber-hover: rgba(78, 237, 184, 0.7);
    --neon-orange: #4EEDB8;
    --cyber-gold: #5FFEC4;
  }

  * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  html {
    overflow-x: hidden;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    font-family: 'Aldrich', 'Space Grotesk', system-ui, sans-serif;
  }

  body {
    overflow-x: hidden;
    width: 100%;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    touch-action: manipulation;
    font-family: 'Aldrich', 'Space Grotesk', system-ui, sans-serif;
  }

  /* Cyberpunk Monospace & Text Styling - Aldrich everywhere */
  .font-mono {
    font-family: 'Aldrich', 'JetBrains Mono', monospace;
  }

  .font-sans {
    font-family: 'Aldrich', 'Space Grotesk', system-ui, sans-serif;
  }

  h1, h2, h3, h4, h5, h6, button, input, textarea, a {
    font-family: 'Aldrich', 'Space Grotesk', system-ui, sans-serif;
  }

  /* Glowing Cyberpunk Text */
  .cyber-gradient-text {
    background: linear-gradient(135deg, #ffffff 15%, #4EEDB8 65%, #5FFEC4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cyber-neon-text {
    color: #4EEDB8;
    text-shadow: 0 0 15px rgba(78, 237, 184, 0.65), 0 0 30px rgba(78, 237, 184, 0.3);
  }

  .cyber-gold-text {
    color: #5FFEC4;
    text-shadow: 0 0 15px rgba(95, 254, 196, 0.6), 0 0 30px rgba(95, 254, 196, 0.25);
  }

  /* Bento & Cyber Card Utility */
  .cyber-card {
    background: var(--bg-card);
    border: 1px solid var(--border-cyber);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .cyber-card:hover {
    border-color: var(--border-cyber-hover);
    box-shadow: 0 10px 30px -10px rgba(78, 237, 184, 0.3), 0 0 20px rgba(95, 254, 196, 0.15);
  }

  /* Magnetic Buttons & Interactive Micro-Animations */
  .magnetic-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    will-change: transform;
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .magnetic-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
    will-change: transform;
  }

  /* Radiant Light Sweep (Shine Effect) */
  .btn-shine {
    position: relative;
    overflow: hidden;
  }

  .btn-shine::after {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.32),
      transparent
    );
    transform: skewX(-25deg);
    transition: left 0.75s ease;
    pointer-events: none;
  }

  .btn-shine:hover::after {
    left: 150%;
  }

  /* Click Ripple Circle */
  .ripple-circle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.45) 0%, transparent 70%);
    transform: scale(0);
    animation: ripple-anim 0.6s linear;
    pointer-events: none;
  }

  @keyframes ripple-anim {
    to {
      transform: scale(3.5);
      opacity: 0;
    }
  }

  /* 3D Tilt Card */
  .tilt-card {
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* No Scrollbar Utility */
  .no-scrollbar::-webkit-scrollbar {
    display: none !important;
  }
  .no-scrollbar {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
  }

  /* Cyber Button with angled clip corner */
  .cyber-btn {
    position: relative;
    clip-path: polygon(10px 0%, 100% 0%, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0% 100%, 0% 10px);
    transition: all 0.25s ease;
  }

  /* Custom Sleek Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #040404;
  }

  ::-webkit-scrollbar-thumb {
    background: #0c1520;
    border-radius: 4px;
    border: 1px solid rgba(78, 237, 184, 0.25);
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(to bottom, #4EEDB8, #5FFEC4);
  }
</style>
