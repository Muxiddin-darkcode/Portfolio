---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Shamsiddinov Muxiddin | IT Mutaxassisi & Dasturchi & Pedagog",
  description = "Shamsiddinov Muxiddin Xusniddin o‘g‘li — IT mutaxassisi, Web Developer, Telegram Bot Developer va IT Educator. Zamonaviy raqamli innovatsiyalar, veb-dasturlash va ta'lim texnologiyalari.",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteUrl = "https://muxiddin-darkcode.github.io";
---

<!doctype html>
<html lang="uz" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}/favicon.png`} />
    <link rel="canonical" href={siteUrl} />

    <link
      rel="preload"
      href={`${baseUrl}/fonts/montserrat-latin-wght-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Open Graph / Facebook / Telegram -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${baseUrl}/images/avatar.jpg`} />
    <meta property="og:site_name" content="Shamsiddinov Muxiddin Portfolio" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}/images/avatar.jpg`} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Shamsiddinov Muxiddin Xusniddin o‘g‘li",
        "alternateName": "Muxiddin-darkcode",
        "jobTitle": "IT Mutaxassisi, Web Developer, Telegram Bot Developer, IT Educator",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Guliston",
          "addressRegion": "Sirdaryo",
          "addressCountry": "O‘zbekiston"
        },
        "worksFor": {
          "@type": "Organization",
          "name": "Rich Boss xususiy maktabi"
        },
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "Guliston davlat pedagogika instituti"
        },
        "sameAs": [
          "https://github.com/Muxiddin-darkcode"
        ],
        "description": "IT mutaxassisi, veb-dasturchi, Telegram botlar ishlab chiquvchisi va ta'lim texnologiyalari ustozi."
      }
    </script>
  </head>
  <body class="bg-[--background] text-[var(--white)] min-h-screen selection:bg-[var(--sec)] selection:text-black relative overflow-x-hidden">
    
    <!-- Top Scroll Progress Bar -->
    <div id="scroll-progress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-[var(--sec)] via-[#38bdf8] to-emerald-400 z-[100] transition-all duration-100 ease-out w-0 shadow-[0_0_12px_rgba(164,118,255,0.8)]"></div>

    <!-- Mouse Cursor Interactive Glow Spotlight -->
    <div id="cursor-glow" class="pointer-events-none fixed -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-[radial-gradient(circle,_rgba(164,118,255,0.12)_0%,_transparent_70%)] blur-2xl z-0 transition-opacity duration-300 opacity-0 md:opacity-100"></div>

    <!-- Ambient glowing backdrop effect -->
    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
      <div class="absolute -top-[10%] left-1/2 -translate-x-1/2 w-[700px] h-[450px] bg-[radial-gradient(ellipse_at_center,_var(--sec-glow)_0%,_transparent_70%)] opacity-35 blur-3xl animate-pulse"></div>
      <div class="absolute top-[35%] -left-[10%] w-[550px] h-[550px] bg-[radial-gradient(ellipse_at_center,_#38bdf820_0%,_transparent_70%)] blur-3xl opacity-25"></div>
      <div class="absolute top-[65%] -right-[10%] w-[550px] h-[550px] bg-[radial-gradient(ellipse_at_center,_#8b5cf625_0%,_transparent_70%)] blur-3xl opacity-25"></div>
      <div class="absolute bottom-0 left-1/3 w-[600px] h-[400px] bg-[radial-gradient(ellipse_at_center,_#10b98115_0%,_transparent_70%)] blur-3xl opacity-20"></div>
    </div>

    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 relative z-10">
      <slot />
    </div>

    <script is:inline>
      // Smooth scroll progress bar
      window.addEventListener("scroll", () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        const progressEl = document.getElementById("scroll-progress");
        if (progressEl) progressEl.style.width = scrollPercent + "%";
      }, { passive: true });

      // Interactive Cursor Glow Follower
      const glow = document.getElementById("cursor-glow");
      if (glow && window.innerWidth >= 768) {
        window.addEventListener("mousemove", (e) => {
          glow.style.left = e.clientX + "px";
          glow.style.top = e.clientY + "px";
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2") format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #090b10;
    --component-bg: #111522ee;
    --card-bg: rgba(18, 23, 34, 0.75);
    --card-border: rgba(255, 255, 255, 0.09);
    --card-border-hover: rgba(164, 118, 255, 0.5);
    --sec: #a476ff;
    --sec-glow: #a476ff40;
    --accent-emerald: #10b981;
    --accent-cyan: #38bdf8;
    --white: #f3f4f6;
    --white-icon: #9ca3af;
    --white-icon-tr: rgba(255, 255, 255, 0.05);
    --white-muted: #6b7280;
  }

  * {
    font-family: "Montserrat Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  /* Custom Glow text utility */
  .shiny-sec {
    background: linear-gradient(135deg, #c084fc 15%, #ffffff 50%, #38bdf8 85%);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shineText 5s linear infinite;
  }

  .shiny-emerald {
    background: linear-gradient(135deg, #34d399 15%, #a7f3d0 50%, #059669 85%);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shineText 5s linear infinite;
  }

  @keyframes shineText {
    0% {
      background-position: 100% 50%;
    }
    50% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 100% 50%;
    }
  }

  /* Floating Animation */
  @keyframes floatSlow {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .animate-float-slow {
    animation: floatSlow 4s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: floatSlow 4s ease-in-out 2s infinite;
  }

  /* Glass Card utility with subtle cybernetic sheen */
  .glass-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .glass-card:hover {
    border-color: var(--card-border-hover);
    box-shadow: 0 12px 35px -10px rgba(164, 118, 255, 0.2), 0 0 15px rgba(56, 189, 248, 0.08);
  }

  /* Scrollbar styles */
  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: #090b10;
  }

  ::-webkit-scrollbar-thumb {
    background: #252b3b;
    border-radius: 9999px;
    border: 2px solid #090b10;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: #252b3b #090b10;
  }
</style>
