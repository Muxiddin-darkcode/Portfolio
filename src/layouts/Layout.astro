---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Shamsiddinov Muxiddin | Full-Stack Dasturchi & IT Pedagog",
  description = "Shamsiddinov Muxiddin Xusniddin o‘g‘li — Full-Stack Web Dasturchi, Aiogram 3 Bot Dasturchi va IT Pedagog. Rich Boss xususiy maktabi ustozi, GDPI talabasi.",
} = Astro.props;

import Preloader from "../components/Preloader.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteUrl = "https://muxiddin-darkcode.github.io";
---

<!doctype html>
<html lang="uz" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}/favicon.png`} />
    <link rel="canonical" href={siteUrl} />

    <!-- Google Fonts: Space Grotesk & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300..800;1,300..800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Telegram / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${baseUrl}/images/avatar.jpg`} />
    <meta property="og:site_name" content="Shamsiddinov Muxiddin Portfolio" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}/images/avatar.jpg`} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Shamsiddinov Muxiddin Xusniddin o‘g‘li",
        "alternateName": "Muxiddin-darkcode",
        "jobTitle": "IT Mutaxassisi, Web Developer, Telegram Bot Developer, IT Educator",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Guliston",
          "addressRegion": "Sirdaryo",
          "addressCountry": "O‘zbekiston"
        },
        "worksFor": {
          "@type": "Organization",
          "name": "Rich Boss xususiy maktabi"
        },
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "Guliston davlat pedagogika instituti"
        },
        "sameAs": [
          "https://github.com/Muxiddin-darkcode"
        ]
      }
    </script>
  </head>
  <body class="bg-[#040404] text-slate-100 font-sans min-h-screen selection:bg-[#ff6b00] selection:text-black relative overflow-x-hidden antialiased">
    <!-- Futuristic Cyber Preloader (2.3s) -->
    <Preloader />
    
    <!-- Top Scroll Progress -->
    <div id="scroll-progress" class="fixed top-0 left-0 h-[2.5px] bg-gradient-to-r from-[#ff3d00] via-[#ff6b00] to-[#ffb800] z-[100] transition-all duration-75 w-0 shadow-[0_0_12px_#ff6b00]"></div>

    <!-- Interactive Ambient Glow Follower -->
    <div id="cursor-glow" class="pointer-events-none fixed -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] rounded-full bg-[radial-gradient(circle,_rgba(255,107,0,0.12)_0%,_rgba(255,184,0,0.05)_40%,_transparent_70%)] blur-2xl z-0 transition-opacity duration-300 opacity-0 md:opacity-100"></div>

    <!-- Atmosphere & Subtle Ambient Glows -->
    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
      <div class="absolute -top-[10%] left-1/2 -translate-x-1/2 w-[900px] h-[550px] bg-[radial-gradient(ellipse_at_center,_rgba(255,107,0,0.16)_0%,_transparent_65%)] blur-3xl"></div>
      <div class="absolute top-[35%] -left-[15%] w-[700px] h-[700px] bg-[radial-gradient(ellipse_at_center,_rgba(255,184,0,0.08)_0%,_transparent_65%)] blur-3xl"></div>
      <div class="absolute top-[65%] -right-[15%] w-[700px] h-[700px] bg-[radial-gradient(ellipse_at_center,_rgba(255,85,0,0.10)_0%,_transparent_65%)] blur-3xl"></div>
      
      <!-- Crisp Grid Lines -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,107,0,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,107,0,0.035)_1px,transparent_1px)] bg-[size:52px_52px] [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_90%)]"></div>
    </div>

    <!-- Main Container -->
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 relative z-10">
      <slot />
    </div>

    <script is:inline>
      // Scroll Progress Bar
      window.addEventListener("scroll", () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        const progressEl = document.getElementById("scroll-progress");
        if (progressEl) progressEl.style.width = scrollPercent + "%";
      }, { passive: true });

      // Interactive Cursor Glow Follower
      const glow = document.getElementById("cursor-glow");
      if (glow && window.innerWidth >= 768) {
        window.addEventListener("mousemove", (e) => {
          glow.style.left = e.clientX + "px";
          glow.style.top = e.clientY + "px";
        }, { passive: true });
      }
    </script>

    <!-- Bundled GSAP Animation Initialization -->
    <script>
      import { initGsapAnimations } from "../scripts/gsapAnimations";

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => initGsapAnimations());
      } else {
        initGsapAnimations();
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-base: #040404;
    --bg-card: rgba(15, 15, 20, 0.75);
    --border-cyber: rgba(255, 107, 0, 0.16);
    --border-cyber-hover: rgba(255, 107, 0, 0.7);
    --neon-orange: #ff6b00;
    --cyber-gold: #ffb800;
  }

  * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  /* Cyberpunk Monospace & Text Styling */
  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  .font-sans {
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  /* Glowing Cyberpunk Text */
  .cyber-gradient-text {
    background: linear-gradient(135deg, #ffffff 15%, #ffb800 65%, #ff6b00 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cyber-neon-text {
    color: #ff6b00;
    text-shadow: 0 0 15px rgba(255, 107, 0, 0.65), 0 0 30px rgba(255, 107, 0, 0.3);
  }

  .cyber-gold-text {
    color: #ffb800;
    text-shadow: 0 0 15px rgba(255, 184, 0, 0.6), 0 0 30px rgba(255, 184, 0, 0.25);
  }

  /* Bento & Cyber Card Utility */
  .cyber-card {
    background: var(--bg-card);
    border: 1px solid var(--border-cyber);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .cyber-card:hover {
    border-color: var(--border-cyber-hover);
    box-shadow: 0 10px 30px -10px rgba(255, 107, 0, 0.3), 0 0 20px rgba(255, 184, 0, 0.15);
  }

  /* Magnetic Buttons & Interactive Micro-Animations */
  .magnetic-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    will-change: transform;
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .magnetic-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
    will-change: transform;
  }

  /* Radiant Light Sweep (Shine Effect) */
  .btn-shine {
    position: relative;
    overflow: hidden;
  }

  .btn-shine::after {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.32),
      transparent
    );
    transform: skewX(-25deg);
    transition: left 0.75s ease;
    pointer-events: none;
  }

  .btn-shine:hover::after {
    left: 150%;
  }

  /* Click Ripple Circle */
  .ripple-circle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.45) 0%, transparent 70%);
    transform: scale(0);
    animation: ripple-anim 0.6s linear;
    pointer-events: none;
  }

  @keyframes ripple-anim {
    to {
      transform: scale(3.5);
      opacity: 0;
    }
  }

  /* 3D Tilt Card */
  .tilt-card {
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* Cyber Button with angled clip corner */
  .cyber-btn {
    position: relative;
    clip-path: polygon(10px 0%, 100% 0%, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0% 100%, 0% 10px);
    transition: all 0.25s ease;
  }

  /* Custom Sleek Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #040404;
  }

  ::-webkit-scrollbar-thumb {
    background: #1c1c24;
    border-radius: 4px;
    border: 1px solid rgba(255, 107, 0, 0.2);
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(to bottom, #ff6b00, #ffb800);
  }
</style>
