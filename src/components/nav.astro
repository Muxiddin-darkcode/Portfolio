---
interface NavItem {
  label: string;
  href: string;
}

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const navItems: NavItem[] = [
  { label: "Asosiy", href: "#home" },
  { label: "Haqimda", href: "#about" },
  { label: "Ko'nikmalar", href: "#skills" },
  { label: "Loyihalar", href: "#projects" },
  { label: "Tajriba", href: "#experience" },
  { label: "Yutuqlar", href: "#achievements" },
  { label: "Bog'lanish", href: "#contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-center px-4 sm:px-6 py-4 pointer-events-none transition-all duration-300">
  <div
    id="main-nav"
    class="pointer-events-auto flex items-center justify-between gap-4 px-5 sm:px-7 py-3 rounded-2xl border border-white/10 bg-[#0c0f17]/90 backdrop-blur-xl shadow-2xl transition-all duration-300 w-full max-w-5xl"
  >
    <!-- Brand Logo with Real Photo -->
    <a href="#home" class="flex items-center gap-2.5 text-white font-bold tracking-tight flex-shrink-0 group">
      <div class="relative w-8 h-8 sm:w-9 sm:h-9 rounded-full overflow-hidden ring-2 ring-[var(--sec)]/60 group-hover:ring-[var(--sec)] shadow-md shadow-[var(--sec)]/20 group-hover:scale-105 transition-all">
        <img
          src={`${baseUrl}/images/profile.jpg`}
          alt="Shamsiddinov Muxiddin"
          class="w-full h-full object-cover object-top"
          loading="eager"
        />
      </div>
      <span class="font-bold text-sm text-gray-200 group-hover:text-white transition-colors">
        Muxiddin<span class="text-[var(--sec)]">.dev</span>
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link px-3.5 py-1.5 rounded-xl text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200 whitespace-nowrap"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Right Action (Telegram / Contact) -->
    <div class="flex items-center gap-3 flex-shrink-0">
      <a
        href="https://t.me/developer_muxiddin"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-xl bg-[var(--sec)]/15 hover:bg-[var(--sec)] text-[var(--sec)] hover:text-white border border-[var(--sec)]/30 text-xs font-semibold transition-all duration-200 hover:scale-105 active:scale-95 whitespace-nowrap"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.04-.75 4.07-1.77 6.78-2.94 8.14-3.51 3.87-1.62 4.67-1.9 5.2-1.91.12 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.19-.04.35z"/>
        </svg>
        <span>Aloqa</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Menyuni ochish"
        class="md:hidden p-2 rounded-xl bg-white/5 border border-white/10 text-gray-300 hover:text-white hover:bg-white/10 active:scale-95 transition-all"
      >
        <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5 hidden">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div
    id="mobile-menu"
    class="pointer-events-auto hidden fixed top-20 left-4 right-4 bg-[#0d1017]/95 border border-white/10 rounded-2xl p-4 backdrop-blur-2xl shadow-2xl flex-col gap-2 transition-all md:hidden z-50"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link px-4 py-2.5 rounded-xl text-xs font-semibold text-gray-300 hover:text-white hover:bg-white/5 transition-colors"
        >
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  mobileBtn?.addEventListener("click", () => {
    const isHidden = mobileMenu?.classList.toggle("hidden");
    if (!isHidden) {
      mobileMenu?.classList.add("flex");
      hamburgerIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
    } else {
      mobileMenu?.classList.remove("flex");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      mobileMenu?.classList.remove("flex");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    });
  });

  // Active link observer
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll(".nav-link");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            navLinks.forEach((link) => {
              if (link.getAttribute("href") === `#${id}`) {
                link.classList.add("text-white", "bg-white/10");
                link.classList.remove("text-gray-400");
              } else {
                link.classList.remove("text-white", "bg-white/10");
                link.classList.add("text-gray-400");
              }
            });
          }
        });
      },
      { threshold: 0.3 }
    );

    sections.forEach((s) => observer.observe(s));
  });
</script>
