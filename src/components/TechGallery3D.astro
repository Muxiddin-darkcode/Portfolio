    color: "#1572B6",
    glow: "rgba(21, 114, 182, 0.6)",
    desc: "3D Transforms, Animatsiyalar, Responsive",
    iconSvg: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path d="M1.5 0h21l-1.9 21.2L12 24l-8.6-2.8L1.5 0zm16.9 7.6H7.1l.3 3.6h9.1l-.6 6.3-4.9 1.4-4.9-1.4-.3-3.6H3.3l.5 6.3L12 22.4l8.2-2.3 1.2-12.5z"/></svg>`
  },
  {
    id: "bootstrap",
    name: "Bootstrap 5",
    tag: "UI",
    color: "#7952B3",
    glow: "rgba(121, 82, 179, 0.7)",
    desc: "Grid tizimi, tezkor komponentlar",
    iconSvg: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm3.8 15.6c0 1.9-1.5 3.4-3.4 3.4H8V5h4.4c1.9 0 3.4 1.5 3.4 3.4 0 1-.4 1.9-1.1 2.5 1 .6 1.7 1.6 1.7 2.7zm-2.4-5.6c0-.8-.6-1.4-1.4-1.4h-2v2.8h2c.8 0 1.4-.6 1.4-1.4zm.4 5c0-.8-.6-1.4-1.4-1.4h-2.4v2.8H12c.8 0 1.4-.6 1.4-1.4z"/></svg>`
  },
  {
    id: "scratch",
    name: "Scratch",
    tag: "ED",
    color: "#F59E0B",
    glow: "rgba(245, 158, 11, 0.7)",
    desc: "Rich Boss: bolalarga IT saboqlari",
    iconSvg: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14.5h-2v-2h2v2zm0-4h-2V7h2v5.5z"/></svg>`
  }
