---

<!-- Bounded, Compact Futuristic 3D Helix Widget -->
<div class="relative w-full max-w-[420px] mx-auto rounded-3xl border border-orange-500/25 bg-[#08080f]/90 p-3 sm:p-4 shadow-[0_20px_50px_rgba(0,0,0,0.85),0_0_30px_rgba(249,115,22,0.12)] backdrop-blur-xl overflow-hidden select-none">
  
  <!-- Subtle Internal Glow Backdrop -->
  <div class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-orange-500/15 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-16 -left-16 w-56 h-56 rounded-full bg-amber-500/15 blur-3xl pointer-events-none"></div>

  <!-- Header Strip: 3D Helix Title & Live Status -->
  <div class="flex items-center justify-between pb-2.5 mb-1 border-b border-orange-500/15 px-1 relative z-20">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_#34d399]"></span>
      <span class="font-mono text-xs font-bold text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-300 uppercase tracking-wider">
        3D HELIX SPYRAL
      </span>
    </div>
    <span class="text-[10px] font-mono text-slate-400 px-2 py-0.5 rounded-full bg-white/5 border border-white/10 flex items-center gap-1">
      <span class="text-orange-400 font-bold">24</span> texnologiya
    </span>
  </div>

  <!-- 3D Helix Viewport Stage (Strictly bounded 360px height) -->
  <div
    id="tech-helix-viewport"
    class="relative w-full h-[350px] sm:h-[370px] flex items-center justify-center cursor-grab active:cursor-grabbing overflow-hidden"
    style="perspective: 850px; transform-style: preserve-3d;"
    aria-label="3D Helix spiral, aylantirish uchun sichqoncha bilan torting"
  >
    <!-- 3D Transform Scene Hub -->
    <div
      id="tech-helix-scene"
      class="relative w-0 h-0 transition-transform duration-75 ease-out"
      style="transform-style: preserve-3d; transform: rotateX(-6deg) rotateY(0deg);"
    >
      {
        techStack.map((tech, index) => (
          <div
            class="helix-card absolute -left-[45px] -top-[65px] w-[90px] sm:w-[94px] h-[130px] sm:h-[135px] rounded-2xl bg-[#0c0d16]/95 border border-white/15 p-2.5 flex flex-col items-center justify-between text-center transition-all duration-300 shadow-[0_8px_20px_rgba(0,0,0,0.8)] backdrop-blur-md group select-none cursor-pointer"
            data-index={index}
            style={`--tech-color: ${tech.color}; --tech-glow: ${tech.glow};`}
          >
            <!-- Card Ambient Glow -->
            <div
              class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none -z-10 blur-sm"
              style={`background: ${tech.glow};`}
            ></div>

            <!-- Top Tag -->
            <div class="w-full flex items-center justify-between">
              <span class="text-[8px] font-mono font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300">
                {tech.tag}
              </span>
              <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${tech.color}; box-shadow: 0 0 5px ${tech.color};`}></span>
            </div>

            <!-- Icon Center -->
            <div
              class="relative my-auto flex items-center justify-center p-2 rounded-xl bg-white/[0.04] border border-white/10 group-hover:scale-110 transition-transform duration-300"
              style={`color: ${tech.color};`}
              set:html={tech.iconSvg}
            />

            <!-- Bottom Title -->
            <div class="w-full text-center">
              <h4 class="text-[11px] font-extrabold text-white tracking-tight group-hover:text-amber-300 transition-colors truncate">
                {tech.name}
              </h4>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Active Hover Spotlight Tooltip -->
    <div
      id="helix-tooltip"
      class="absolute bottom-2 left-1/2 -translate-x-1/2 pointer-events-none opacity-0 transition-all duration-300 z-30 px-3 py-1 rounded-xl bg-[#0f111c]/95 border border-orange-500/40 backdrop-blur-xl shadow-[0_8px_20px_rgba(0,0,0,0.9)] flex items-center gap-2 max-w-[90%]"
    >
      <span id="helix-tooltip-dot" class="w-2 h-2 rounded-full bg-orange-400 flex-shrink-0"></span>
      <span id="helix-tooltip-name" class="font-bold text-xs text-white flex-shrink-0">Python</span>
      <span class="text-slate-500 text-[10px]">&middot;</span>
      <span id="helix-tooltip-desc" class="text-[10px] text-slate-300 font-mono truncate">Aiogram 3, Backend</span>
    </div>

  </div>

  <!-- Bottom Interactive Helper Pill -->
  <div class="mt-2 pt-2 border-t border-orange-500/15 flex items-center justify-between text-[10px] font-mono text-slate-400 px-1">
    <div class="flex items-center gap-1 text-orange-400">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 animate-spin [animation-duration:6s]">
        <path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 01-9.201 2.466l-.312-.311h2.433a.75.75 0 000-1.5H3.75a.75.75 0 00-.75.75v4.482a.75.75 0 001.5 0v-2.09l.363.363a7 7 0 1010.449-7.382.75.75 0 10-1.228.859 5.486 5.486 0 011.228 2.333z" clip-rule="evenodd" />
      </svg>
      <span>Uzluksiz 3D aylanish</span>
    </div>
    <span class="text-slate-500">Aylantirish uchun suring &bull; 360&deg;</span>
  </div>

</div>

<script is:inline>
  (function initCompactHelix() {
    const viewport = document.getElementById("tech-helix-viewport");
    const scene = document.getElementById("tech-helix-scene");
    const cards = Array.from(document.querySelectorAll(".helix-card"));
    const tooltip = document.getElementById("helix-tooltip");
    const tooltipName = document.getElementById("helix-tooltip-name");
    const tooltipDesc = document.getElementById("helix-tooltip-desc");
    const tooltipDot = document.getElementById("helix-tooltip-dot");

    if (!viewport || !scene || cards.length === 0) return;

    const count = cards.length;

    // Compact proportional radius (fits strictly within container)
    function getRadius() {
      return window.innerWidth < 640 ? 125 : 155;
    }

    // Position all cards into a compact 3D DNA Helix Spiral
    function arrangeHelix() {
      const radius = getRadius();
      const verticalStep = 13.5; // Compact vertical pitch
      const angleStep = 30; // 30 degrees per card -> 2 complete turns for 24 cards

      cards.forEach((card, i) => {
        const theta = i * angleStep;
        const y = (i - count / 2) * verticalStep;
        
        card.style.transform = `translateY(${y}px) rotateY(${theta}deg) translateZ(${radius}px)`;
      });
    }

    arrangeHelix();
    window.addEventListener("resize", arrangeHelix, { passive: true });

    // Rotation & drag interaction state
    let rotX = -6;
    let rotY = 0;
    let targetRotX = -6;
    let targetRotY = 0;

    let isDragging = false;
    let lastX = 0;
    let lastY = 0;
    let velX = 0;
    let velY = 0;

    let isHoveringCard = false;
    const autoSpeed = 0.28; // Smooth ambient rotation pace

    function handleDown(clientX, clientY) {
      isDragging = true;
      lastX = clientX;
      lastY = clientY;
      velX = 0;
      velY = 0;
    }

    function handleMove(clientX, clientY) {
      if (!isDragging) return;
      const dx = clientX - lastX;
      const dy = clientY - lastY;

      targetRotY += dx * 0.4;
      targetRotX -= dy * 0.25;

      // Restrict pitch so cards don't turn upside down
      targetRotX = Math.max(-25, Math.min(25, targetRotX));

      velX = dx;
      velY = dy;
      lastX = clientX;
      lastY = clientY;
    }

    function handleUp() {
      isDragging = false;
    }

    // Mouse handlers
    viewport.addEventListener("mousedown", (e) => handleDown(e.clientX, e.clientY));
    window.addEventListener("mousemove", (e) => handleMove(e.clientX, e.clientY));
    window.addEventListener("mouseup", handleUp);

    // Touch handlers for mobile
    viewport.addEventListener("touchstart", (e) => {
      if (e.touches.length === 1) handleDown(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });

    window.addEventListener("touchmove", (e) => {
      if (isDragging && e.touches.length === 1) handleMove(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });

    window.addEventListener("touchend", handleUp);

    // Card hover inspection
    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        isHoveringCard = true;
        const name = card.querySelector("h4")?.textContent || "";
        const desc = card.getAttribute("title") || card.querySelector("p")?.textContent || "";
        const color = card.style.getPropertyValue("--tech-color") || "#ff6b00";

        if (tooltip && tooltipName && tooltipDot) {
          tooltipName.textContent = name;
          if (tooltipDesc) tooltipDesc.textContent = desc || name;
          tooltipDot.style.backgroundColor = color;
          tooltipDot.style.boxShadow = `0 0 8px ${color}`;
          tooltip.style.opacity = "1";
        }
      });

      card.addEventListener("mouseleave", () => {
        isHoveringCard = false;
        if (tooltip) tooltip.style.opacity = "0";
      });
    });

    // Animation Loop with dynamic depth fading for back-facing cards
    function animate() {
      requestAnimationFrame(animate);

      if (!isDragging) {
        if (!isHoveringCard) {
          targetRotY += autoSpeed;
        }
        targetRotY += velX * 0.12;
        targetRotX -= velY * 0.08;
        velX *= 0.92;
        velY *= 0.92;
      }

      // Smooth interpolation (lerp)
      rotX += (targetRotX - rotX) * 0.1;
      rotY += (targetRotY - rotY) * 0.1;

      scene.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;

      // Depth perception: Fade back-facing cards for clean visual clarity
      const radY = (rotY * Math.PI) / 180;
      cards.forEach((card, i) => {
        const cardAngle = (i * 30 * Math.PI) / 180 + radY;
        const cosAngle = Math.cos(cardAngle); // 1 = facing front, -1 = facing back
        
        if (cosAngle < -0.15) {
          card.style.opacity = "0.3";
          card.style.filter = "blur(1px) brightness(0.6)";
        } else {
          card.style.opacity = (0.55 + cosAngle * 0.45).toFixed(2);
          card.style.filter = "none";
        }
      });
    }

    animate();
  })();
</script>
