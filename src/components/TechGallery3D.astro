<div class="relative w-full max-w-full flex flex-col items-center justify-center overflow-visible py-4 select-none">
  
  <!-- Subtle Glowing Stage Ambient Backdrop -->
  <div class="absolute -top-16 left-1/2 -translate-x-1/2 w-full max-w-lg h-80 rounded-full bg-gradient-to-tr from-orange-600/15 via-amber-500/15 to-yellow-400/10 blur-[90px] pointer-events-none -z-10"></div>
  
  <!-- Top Stage Title & Indicator -->
  <div class="flex items-center justify-between w-full max-w-lg px-2 mb-2">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span class="font-mono text-xs text-orange-400 font-bold uppercase tracking-wider">
        Motion.Dev 3D Texnologiyalar Galereyasi
      </span>
    </div>
    <span class="text-[11px] font-mono text-slate-400 px-2 py-0.5 rounded-full bg-[#11111a] border border-orange-500/20">
      24 ta vosita &middot; 3D Interaktiv
    </span>
  </div>

  <!-- Main 3D Viewport & Carousel Stage -->
  <div
    id="tech-3d-viewport"
    class="relative w-full h-[400px] sm:h-[430px] flex items-center justify-center cursor-grab active:cursor-grabbing overflow-visible"
    style="perspective: 1100px; transform-style: preserve-3d;"
    aria-label="3D texnologiyalar galereyasi, aylantirish uchun sichqoncha bilan torting"
  >
    <!-- 3D Transform Hub (World Scene) -->
    <div
      id="tech-3d-scene"
      class="relative w-0 h-0 transition-transform duration-75 ease-out"
      style="transform-style: preserve-3d; transform: rotateX(-4deg) rotateY(0deg);"
    >
      {
        techStack.map((tech, index) => (
          <div
            class="tech-card absolute -left-[65px] -top-[95px] w-[130px] sm:w-[136px] h-[190px] sm:h-[195px] rounded-2xl bg-[#0b0c14]/90 border border-white/15 p-3.5 flex flex-col items-center justify-between text-center transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-orange-400/80 hover:bg-[#121422] shadow-[0_10px_25px_rgba(0,0,0,0.8)] backdrop-blur-md group select-none"
            data-index={index}
            style={`--tech-color: ${tech.color}; --tech-glow: ${tech.glow};`}
          >
            <!-- Card Ambient Glow when hovered -->
            <div
              class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none -z-10 blur-md"
              style={`background: ${tech.glow};`}
            ></div>

            <!-- Top Category Pill -->
            <div class="w-full flex items-center justify-between">
              <span class="text-[9px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/5 border border-white/10 text-slate-300 group-hover:text-white group-hover:border-orange-400/40 transition-colors">
                {tech.category}
              </span>
              <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${tech.color}; box-shadow: 0 0 6px ${tech.color};`}></span>
            </div>

            <!-- Icon Center -->
            <div
              class="relative my-auto flex items-center justify-center p-3 rounded-xl bg-white/[0.04] border border-white/10 text-white group-hover:scale-110 group-hover:border-orange-400/50 transition-all duration-300 shadow-inner"
              style={`color: ${tech.color};`}
              set:html={tech.iconSvg}
            />

            <!-- Bottom Title & Details -->
            <div class="w-full text-center mt-1">
              <h4 class="text-xs sm:text-sm font-extrabold text-white tracking-tight group-hover:text-amber-300 transition-colors truncate">
                {tech.name}
              </h4>
              <p class="text-[10px] text-slate-400 font-mono truncate mt-0.5">
                {tech.level}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Active Card Spotlight Tooltip / Info Badge (Shown on hover) -->
    <div
      id="tech-hover-tooltip"
      class="absolute bottom-2 left-1/2 -translate-x-1/2 pointer-events-none opacity-0 transition-all duration-300 z-30 px-3.5 py-1.5 rounded-xl bg-[#0f111c]/95 border border-orange-500/40 backdrop-blur-xl shadow-[0_10px_25px_rgba(0,0,0,0.85)] flex items-center gap-2"
    >
      <span id="tooltip-dot" class="w-2 h-2 rounded-full bg-orange-400 shadow-[0_0_8px_#ff6b00]"></span>
      <span id="tooltip-name" class="font-bold text-xs text-white">Python</span>
      <span class="text-slate-500 text-[10px]">&middot;</span>
      <span id="tooltip-desc" class="text-[11px] text-slate-300 font-mono">Aiogram 3, Skriptlar, Backend</span>
    </div>

  </div>

  <!-- Interactive 3D Mode Switcher (HELIX, BARREL, RING, SPHERE) exactly like Image 2 -->
  <div class="relative z-20 flex items-center justify-center gap-1.5 sm:gap-2 p-1.5 rounded-2xl bg-[#090a12]/95 border border-orange-500/25 shadow-[0_10px_35px_rgba(0,0,0,0.85)] backdrop-blur-xl mt-1">
    
    <button
      type="button"
      data-mode="helix"
      class="mode-btn px-3 sm:px-4 py-1.5 rounded-xl font-mono text-[11px] sm:text-xs font-bold uppercase tracking-wider text-slate-400 hover:text-white transition-all duration-200 active:scale-95"
    >
      HELIX
    </button>

    <button
      type="button"
      data-mode="barrel"
      class="mode-btn px-3 sm:px-4 py-1.5 rounded-xl font-mono text-[11px] sm:text-xs font-bold uppercase tracking-wider text-slate-400 hover:text-white transition-all duration-200 active:scale-95"
    >
      BARREL
    </button>

    <button
      type="button"
      data-mode="ring"
      class="mode-btn active-mode px-3 sm:px-4 py-1.5 rounded-xl font-mono text-[11px] sm:text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-orange-500 to-amber-500 text-stone-950 shadow-md shadow-orange-500/30 transition-all duration-200 active:scale-95"
    >
      RING
    </button>

    <button
      type="button"
      data-mode="sphere"
      class="mode-btn px-3 sm:px-4 py-1.5 rounded-xl font-mono text-[11px] sm:text-xs font-bold uppercase tracking-wider text-slate-400 hover:text-white transition-all duration-200 active:scale-95"
    >
      SPHERE
    </button>

  </div>

  <!-- Instruction Tip -->
  <p class="text-[10px] font-mono text-slate-500 mt-2 flex items-center gap-1.5">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 text-orange-400">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-11.25a.75.75 0 00-1.5 0v4.59L7.3 9.24a.75.75 0 00-1.1 1.02l3.25 3.5a.75.75 0 001.1 0l3.25-3.5a.75.75 0 10-1.1-1.02l-1.95 2.1V6.75z" clip-rule="evenodd" />
    </svg>
    <span>Sichqoncha yoki barmoq bilan ushlab aylantiring</span>
  </p>

</div>

<script is:inline>
  (function initTechGallery3D() {
    const viewport = document.getElementById("tech-3d-viewport");
    const scene = document.getElementById("tech-3d-scene");
    const cards = Array.from(document.querySelectorAll(".tech-card"));
    const modeBtns = document.querySelectorAll(".mode-btn");
    const tooltip = document.getElementById("tech-hover-tooltip");
    const tooltipName = document.getElementById("tooltip-name");
    const tooltipDesc = document.getElementById("tooltip-desc");
    const tooltipDot = document.getElementById("tooltip-dot");

    if (!viewport || !scene || cards.length === 0) return;

    const count = cards.length;
    let currentMode = "ring"; // Initial mode is RING

    // Rotation state
    let rotX = -5;
    let rotY = 0;
    let targetRotX = -5;
    let targetRotY = 0;

    let isDragging = false;
    let lastX = 0;
    let lastY = 0;
    let velX = 0;
    let velY = 0;

    let isHoveringCard = false;
    let autoRotateSpeed = 0.22; // Smooth cinematic pace

    // Calculate responsive radius
    function getRadius() {
      const isMobile = window.innerWidth < 640;
      return isMobile ? 260 : 360;
    }

    // Apply layout positions according to active 3D mode
    function applyLayout(mode) {
      currentMode = mode;
      const radius = getRadius();

      cards.forEach((card, i) => {
        let transformStr = "";

        if (mode === "ring") {
          // Circular horizontal ring
          const theta = (i / count) * 360;
          transformStr = `rotateY(${theta}deg) translateZ(${radius}px)`;
        } else if (mode === "helix") {
          // DNA vertical spiral helix
          const theta = i * 30; // 30 deg per step
          const y = (i - count / 2) * 18;
          transformStr = `translateY(${y}px) rotateY(${theta}deg) translateZ(${radius * 0.92}px)`;
        } else if (mode === "barrel") {
          // Curved cylindrical drum barrel
          const cols = 8;
          const row = Math.floor(i / cols); // 0, 1, 2
          const col = i % cols;
          const theta = (col / cols) * 360;
          const y = (row - 1) * 115;
          const tiltX = (row - 1) * -14;
          transformStr = `translateY(${y}px) rotateY(${theta}deg) translateZ(${radius * 0.95}px) rotateX(${tiltX}deg)`;
        } else if (mode === "sphere") {
          // Fibonacci 3D Sphere distribution
          const phi = Math.acos(-1 + (2 * i) / count);
          const theta = Math.sqrt(count * Math.PI) * phi;
          const degY = theta * (180 / Math.PI);
          const degX = (phi - Math.PI / 2) * (180 / Math.PI);
          transformStr = `rotateY(${degY}deg) rotateX(${degX}deg) translateZ(${radius * 0.95}px)`;
        }

        card.style.transform = transformStr;
      });
    }

    // Initialize initial layout
    applyLayout(currentMode);

    // Mode Switcher Buttons
    modeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.getAttribute("data-mode");
        if (!mode || mode === currentMode) return;

        modeBtns.forEach((b) => {
          b.classList.remove("active-mode", "bg-gradient-to-r", "from-orange-500", "to-amber-500", "text-stone-950", "shadow-md", "shadow-orange-500/30");
          b.classList.add("text-slate-400");
        });

        btn.classList.add("active-mode", "bg-gradient-to-r", "from-orange-500", "to-amber-500", "text-stone-950", "shadow-md", "shadow-orange-500/30");
        btn.classList.remove("text-slate-400");

        applyLayout(mode);
      });
    });

    // Resize listener to re-compute radius
    window.addEventListener("resize", () => {
      applyLayout(currentMode);
    }, { passive: true });

    // Drag / Touch Interactions
    function handlePointerDown(clientX, clientY) {
      isDragging = true;
      lastX = clientX;
      lastY = clientY;
      velX = 0;
      velY = 0;
    }

    function handlePointerMove(clientX, clientY) {
      if (!isDragging) return;

      const deltaX = clientX - lastX;
      const deltaY = clientY - lastY;

      targetRotY += deltaX * 0.35;
      targetRotX -= deltaY * 0.25;

      // Limit pitch to prevent flipping upside down
      targetRotX = Math.max(-45, Math.min(45, targetRotX));

      velX = deltaX;
      velY = deltaY;

      lastX = clientX;
      lastY = clientY;
    }

    function handlePointerUp() {
      isDragging = false;
    }

    // Mouse events
    viewport.addEventListener("mousedown", (e) => {
      handlePointerDown(e.clientX, e.clientY);
    });

    window.addEventListener("mousemove", (e) => {
      handlePointerMove(e.clientX, e.clientY);
    });

    window.addEventListener("mouseup", () => {
      handlePointerUp();
    });

    // Touch events for mobile
    viewport.addEventListener("touchstart", (e) => {
      if (e.touches.length === 1) {
        handlePointerDown(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    window.addEventListener("touchmove", (e) => {
      if (isDragging && e.touches.length === 1) {
        handlePointerMove(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    window.addEventListener("touchend", () => {
      handlePointerUp();
    });

    // Card Hover details & Pause on hover
    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        isHoveringCard = true;
        const name = card.querySelector("h4")?.textContent || "";
        const desc = card.querySelector("p")?.textContent || "";
        const color = card.style.getPropertyValue("--tech-color") || "#ff6b00";

        if (tooltip && tooltipName && tooltipDesc && tooltipDot) {
          tooltipName.textContent = name;
          tooltipDesc.textContent = desc;
          tooltipDot.style.backgroundColor = color;
          tooltipDot.style.boxShadow = `0 0 10px ${color}`;
          tooltip.style.opacity = "1";
          tooltip.style.transform = "translate(-50%, -4px)";
        }
      });

      card.addEventListener("mouseleave", () => {
        isHoveringCard = false;
        if (tooltip) {
          tooltip.style.opacity = "0";
          tooltip.style.transform = "translate(-50%, 0)";
        }
      });
    });

    // Smooth Animation Loop
    function animate() {
      requestAnimationFrame(animate);

      if (!isDragging) {
        // Continuous auto rotation unless hovering a card
        if (!isHoveringCard) {
          targetRotY += autoRotateSpeed;
        }

        // Apply inertia dampening
        targetRotY += velX * 0.15;
        targetRotX -= velY * 0.1;
        velX *= 0.92;
        velY *= 0.92;
      }

      // Smooth interpolation (lerp)
      rotX += (targetRotX - rotX) * 0.12;
      rotY += (targetRotY - rotY) * 0.12;

      scene.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
    }

    animate();
  })();
</script>
