---

<!-- Pure, Borderless 3D Helix Stage: Clean floating cards with smooth self-rotation -->
<div class="helix-wrapper relative w-full flex items-center justify-center overflow-visible select-none py-2">
  
  <!-- Main 3D Viewport -->
  <div
    id="tech-helix-viewport"
    class="relative w-full flex items-center justify-center cursor-grab active:cursor-grabbing overflow-visible"
    aria-label="3D Helix Carousel"
  >
    <!-- 3D Rotating Scene Hub -->
    <div
      id="tech-helix-scene"
      class="relative w-0 h-0 transition-transform duration-75 ease-out"
    >
      {
        techStack.map((tech, index) => (
          <div
            class="helix-card absolute rounded-2xl p-3 flex flex-col items-center justify-between text-center select-none cursor-pointer"
            data-index={index}
            style={`background: ${tech.bgGrad}; border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7);`}
          >
            <!-- Card Glow Ring on Hover -->
            <div
              class="card-glow absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300 pointer-events-none -z-10 blur-md"
              style={`background: ${tech.color}; opacity: 0.15;`}
            ></div>

            <!-- Top Tag -->
            <div class="w-full flex items-center justify-between pointer-events-none">
              <span class="text-[9px] font-mono font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-white/10 text-white/90">
                {tech.tag}
              </span>
              <span class="w-2 h-2 rounded-full" style={`background-color: ${tech.color}; box-shadow: 0 0 8px ${tech.color};`}></span>
            </div>

            <!-- Icon Center -->
            <div
              class="relative my-auto flex items-center justify-center p-2.5 rounded-xl bg-white/[0.08] backdrop-blur-sm pointer-events-none transition-transform duration-300"
              style={`color: ${tech.color};`}
              set:html={tech.iconSvg}
            />

            <!-- Bottom Title -->
            <div class="w-full text-center pointer-events-none">
              <h4 class="text-xs sm:text-sm font-extrabold text-white tracking-tight truncate drop-shadow-sm">
                {tech.name}
              </h4>
            </div>
          </div>
        ))
      }
    </div>
  </div>

</div>

<!-- Responsive Media Queries and 3D Perspective CSS -->
<style is:inline>
  .helix-wrapper {
    touch-action: pan-y;
  }

  #tech-helix-viewport {
    perspective: 750px;
    transform-style: preserve-3d;
    height: 380px;
  }

  #tech-helix-scene {
    transform-style: preserve-3d;
  }

  /* Compact Playing-Card Proportion */
  .helix-card {
    width: 90px;
    height: 135px;
    margin-left: -45px;
    margin-top: -67px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transform-style: preserve-3d;
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  .helix-card:hover {
    border-color: rgba(255, 184, 0, 0.7) !important;
    transform: scale(1.1) !important;
    z-index: 50;
  }

  /* Responsive Media Query Breakpoints */
  @media (min-width: 640px) {
    #tech-helix-viewport {
      perspective: 900px;
      height: 440px;
    }
    .helix-card {
      width: 104px;
      height: 156px;
      margin-left: -52px;
      margin-top: -78px;
    }
  }

  @media (min-width: 1024px) {
    #tech-helix-viewport {
      perspective: 1050px;
      height: 480px;
    }
    .helix-card {
      width: 114px;
      height: 170px;
      margin-left: -57px;
      margin-top: -85px;
    }
  }
</style>

<script is:inline>
  (function initPureHelix() {
    const viewport = document.getElementById("tech-helix-viewport");
    const scene = document.getElementById("tech-helix-scene");
    const cards = Array.from(document.querySelectorAll(".helix-card"));

    if (!viewport || !scene || cards.length === 0) return;

    const count = cards.length;

    // Responsive dimensions calculated via media queries
    function getHelixParams() {
      const w = window.innerWidth;
      if (w < 640) {
        return { radius: 140, verticalStep: 20, angleStep: 34 };
      } else if (w < 1024) {
        return { radius: 180, verticalStep: 24, angleStep: 34 };
      } else {
        return { radius: 215, verticalStep: 28, angleStep: 34 };
      }
    }

    // Position cards into pure 3D DNA Helix Spiral like Motion.dev demo
    function layoutHelix() {
      const { radius, verticalStep, angleStep } = getHelixParams();

      cards.forEach((card, i) => {
        const theta = i * angleStep;
        const y = (i - count / 2) * verticalStep;
        
        card.setAttribute("data-base-y", y.toString());
        card.setAttribute("data-theta", theta.toString());
        card.style.transform = `translateY(${y}px) rotateY(${theta}deg) translateZ(${radius}px)`;
      });
    }

    layoutHelix();
    window.addEventListener("resize", layoutHelix, { passive: true });

    // Rotation & auto-spin state
    let rotX = -6;
    let rotY = 0;
    let targetRotX = -6;
    let targetRotY = 0;

    let isDragging = false;
    let lastX = 0;
    let lastY = 0;
    let velX = 0;
    let velY = 0;

    let isHovering = false;
    const autoSpeed = 0.35; // Smooth graceful continuous self-rotation

    function handleStart(clientX, clientY) {
      isDragging = true;
      lastX = clientX;
      lastY = clientY;
      velX = 0;
      velY = 0;
    }

    function handleMove(clientX, clientY) {
      if (!isDragging) return;
      const dx = clientX - lastX;
      const dy = clientY - lastY;

      targetRotY += dx * 0.45;
      targetRotX -= dy * 0.25;

      // Keep pitch restrained so helix looks stunning and balanced
      targetRotX = Math.max(-20, Math.min(20, targetRotX));

      velX = dx;
      velY = dy;
      lastX = clientX;
      lastY = clientY;
    }

    function handleEnd() {
      isDragging = false;
    }

    // Mouse drag
    viewport.addEventListener("mousedown", (e) => handleStart(e.clientX, e.clientY));
    window.addEventListener("mousemove", (e) => handleMove(e.clientX, e.clientY));
    window.addEventListener("mouseup", handleEnd);

    // Touch swipe
    viewport.addEventListener("touchstart", (e) => {
      if (e.touches.length === 1) handleStart(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });

    window.addEventListener("touchmove", (e) => {
      if (isDragging && e.touches.length === 1) handleMove(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });

    window.addEventListener("touchend", handleEnd);

    // Pause on hover
    viewport.addEventListener("mouseenter", () => { isHovering = true; });
    viewport.addEventListener("mouseleave", () => { isHovering = false; });

    // Render loop with spatial depth perception (Motion.dev style)
    function render() {
      requestAnimationFrame(render);

      if (!isDragging) {
        if (!isHovering) {
          targetRotY += autoSpeed;
        }
        targetRotY += velX * 0.1;
        targetRotX -= velY * 0.08;
        velX *= 0.92;
        velY *= 0.92;
      }

      // Smooth interpolation (lerp)
      rotX += (targetRotX - rotX) * 0.1;
      rotY += (targetRotY - rotY) * 0.1;

      scene.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;

      // Dynamic depth fading: cards in back fade out softly, front cards are vivid and sharp
      const radY = (rotY * Math.PI) / 180;
      const angleStepRad = (34 * Math.PI) / 180;

      cards.forEach((card, i) => {
        const cardAngle = i * angleStepRad + radY;
        const cosVal = Math.cos(cardAngle); // 1 = facing front, -1 = facing back

        if (cosVal < -0.1) {
          card.style.opacity = "0.22";
          card.style.filter = "blur(0.8px) brightness(0.65)";
        } else {
          const alpha = 0.5 + cosVal * 0.5;
          card.style.opacity = alpha.toFixed(2);
          card.style.filter = "none";
        }
      });
    }

    render();
  })();
</script>
