---

<!-- Pure, Borderless 3D Helix Stage: Continuous, unclipped, autonomous self-rotation -->
<div class="helix-wrapper relative w-full flex items-center justify-center select-none py-2 sm:py-4 overflow-visible pointer-events-none">
  
  <!-- Main 3D Viewport with Large Unclipped Stage -->
  <div
    id="tech-helix-viewport"
    class="relative w-full flex items-center justify-center pointer-events-none"
    aria-label="3D Helix Carousel"
  >
    <!-- 3D Rotating Scene Hub -->
    <div
      id="tech-helix-scene"
      class="relative w-0 h-0 pointer-events-none"
    >
      {
        techStack.map((tech, index) => (
          <div
            class="helix-card absolute rounded-xl sm:rounded-2xl p-2 sm:p-2.5 md:p-3 flex flex-col items-center justify-between text-center select-none pointer-events-none"
            data-index={index}
            style={`background: ${tech.bgGrad}; border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.7);`}
          >
            <!-- Card Glow Ring -->
            <div
              class="card-glow absolute inset-0 rounded-xl sm:rounded-2xl opacity-15 pointer-events-none -z-10 blur-md"
              style={`background: ${tech.color};`}
            ></div>

            <!-- Top Tag & Status Dot -->
            <div class="w-full flex items-center justify-between pointer-events-none mb-1">
              <span class="text-[7.5px] sm:text-[8.5px] md:text-[9.5px] font-mono font-bold uppercase tracking-wider px-1 sm:px-1.5 py-0.5 rounded-full bg-white/10 text-white/90">
                {tech.tag}
              </span>
              <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full" style={`background-color: ${tech.color}; box-shadow: 0 0 6px ${tech.color};`}></span>
            </div>

            <!-- Icon Center: Authentic Sharp Vector Brand Icon -->
            <div
              class="relative my-auto flex items-center justify-center w-7 h-7 sm:w-9 sm:h-9 md:w-10 md:h-10 p-1 sm:p-1.5 rounded-xl bg-white/[0.08] backdrop-blur-sm pointer-events-none"
              set:html={tech.iconSvg}
            />

            <!-- Bottom Title -->
            <div class="w-full text-center pointer-events-none mt-1">
              <h4 class="text-[9.5px] sm:text-xs md:text-sm font-extrabold text-white tracking-tight truncate drop-shadow-sm">
                {tech.name}
              </h4>
            </div>
          </div>
        ))
      }
    </div>
  </div>

</div>

<!-- Responsive Media Queries and 3D Perspective CSS -->
<style is:inline>
  .helix-wrapper {
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  /* Large unclipped viewport so cards never get cut off at top or bottom */
  #tech-helix-viewport {
    perspective: 750px;
    transform-style: preserve-3d;
    height: 480px;
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  #tech-helix-scene {
    transform-style: preserve-3d;
  }

  /* Playing-Card Proportion on Mobile (Zero collision, No clipping) */
  .helix-card {
    width: 74px;
    height: 110px;
    margin-left: -37px;
    margin-top: -55px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transform-style: preserve-3d;
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  /* Tablet Media Query (>= 640px) */
  @media (min-width: 640px) {
    #tech-helix-viewport {
      perspective: 900px;
      height: 520px;
    }
    .helix-card {
      width: 90px;
      height: 134px;
      margin-left: -45px;
      margin-top: -67px;
    }
  }

  /* Desktop Media Query (>= 1024px) */
  @media (min-width: 1024px) {
    #tech-helix-viewport {
      perspective: 1050px;
      height: 560px;
    }
    .helix-card {
      width: 104px;
      height: 156px;
      margin-left: -52px;
      margin-top: -78px;
    }
  }
</style>

<script is:inline>
  (function initPureHelix() {
    const viewport = document.getElementById("tech-helix-viewport");
    const scene = document.getElementById("tech-helix-scene");
    const cards = Array.from(document.querySelectorAll(".helix-card"));

    if (!viewport || !scene || cards.length === 0) return;

    const count = cards.length;
    let currentAngleStep = 42;

    // Responsive dimensions: arc distance > card width so cards NEVER touch or collide
    function getHelixParams() {
      const w = window.innerWidth;
      if (w < 640) {
        // Mobile: 74px card width, 110px radius, 42° angle step (Arc = 81px > 74px -> zero overlap)
        return { radius: 110, verticalStep: 14, angleStep: 42 };
      } else if (w < 1024) {
        // Tablet: 90px card width, 155px radius, 36° angle step (Arc = 97px > 90px -> zero overlap)
        return { radius: 155, verticalStep: 18, angleStep: 36 };
      } else {
        // Desktop: 104px card width, 195px radius, 32° angle step (Arc = 109px > 104px -> zero overlap)
        return { radius: 195, verticalStep: 22, angleStep: 32 };
      }
    }

    // Position cards into pure 3D DNA Helix Spiral
    function layoutHelix() {
      const { radius, verticalStep, angleStep } = getHelixParams();
      currentAngleStep = angleStep;

      cards.forEach((card, i) => {
        const theta = i * angleStep;
        const y = (i - count / 2) * verticalStep;
        
        card.setAttribute("data-base-y", y.toString());
        card.setAttribute("data-theta", theta.toString());
        card.style.transform = `translateY(${y}px) rotateY(${theta}deg) translateZ(${radius}px)`;
      });
    }

    layoutHelix();
    window.addEventListener("resize", layoutHelix, { passive: true });

    // Autonomous continuous self-rotation that NEVER stops (immune to mouse & touch)
    let rotY = 0;
    const autoSpeed = 0.38; // Smooth, steady cinematic rotation

    function render() {
      requestAnimationFrame(render);
      rotY += autoSpeed;

      scene.style.transform = `rotateX(-6deg) rotateY(${rotY}deg)`;

      // Dynamic depth fading: cards in back fade out softly, front cards are vivid and sharp
      const radY = (rotY * Math.PI) / 180;
      const angleStepRad = (currentAngleStep * Math.PI) / 180;

      cards.forEach((card, i) => {
        const cardAngle = i * angleStepRad + radY;
        const cosVal = Math.cos(cardAngle); // 1 = facing front, -1 = facing back

        if (cosVal < -0.1) {
          card.style.opacity = "0.22";
          card.style.filter = "blur(0.8px) brightness(0.65)";
        } else {
          const alpha = 0.5 + cosVal * 0.5;
          card.style.opacity = alpha.toFixed(2);
          card.style.filter = "none";
        }
      });
    }

    render();
  })();
</script>
