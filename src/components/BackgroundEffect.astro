---
// Soddaroq, zamonaviy va nafis orqa fon animatsiyasi (Floating Luminous Particles + Breathing Aurora Glow)
---

<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden select-none bg-[#030608]">
  
  <!-- 1. Yumshoq nafas oluvchi Aurora nurlari (GPU tezlashuvi bilan sekin suzuvchi auralar) -->
  <div class="aurora-orb orb-1"></div>
  <div class="aurora-orb orb-2"></div>
  <div class="aurora-orb orb-3"></div>

  <!-- 2. Nozik nuqtali zamonaviy kiber-to'r (Dot Matrix) -->
  <div class="absolute inset-0 bg-[radial-gradient(rgba(78,237,184,0.07)_1px,transparent_1px)] bg-[size:38px_38px] [mask-image:radial-gradient(ellipse_at_center,black_50%,transparent_92%)] opacity-80"></div>

  <!-- 3. HTML5 Canvas: Sekin suzuvchi va miltillovchi oq & yalpiz mikrozarrachalar (Starfield / Floating Embers) -->
  <canvas id="bg-particle-canvas" class="absolute inset-0 w-full h-full"></canvas>

  <!-- 4. Mayin interaktiv kursor nuri (Cursor Spotlight) -->
  <div id="cursor-glow" class="pointer-events-none fixed -translate-x-1/2 -translate-y-1/2 w-[420px] h-[420px] rounded-full bg-[radial-gradient(circle,_rgba(78,237,184,0.1)_0%,_rgba(95,254,196,0.03)_45%,_transparent_70%)] blur-2xl transition-opacity duration-300 opacity-0 md:opacity-100 will-change-transform"></div>

</div>

<style>
  /* Sokin va tabiiy nafas oluvchi fon auralari */
  .aurora-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .orb-1 {
    top: -15%;
    left: 25%;
    width: 650px;
    height: 480px;
    background: radial-gradient(circle, #4EEDB8 0%, transparent 70%);
    animation: floatAurora1 24s ease-in-out infinite alternate;
  }

  .orb-2 {
    top: 38%;
    right: -12%;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, #5FFEC4 0%, transparent 70%);
    animation: floatAurora2 28s ease-in-out infinite alternate;
  }

  .orb-3 {
    bottom: -15%;
    left: -8%;
    width: 700px;
    height: 520px;
    background: radial-gradient(circle, #00F5A0 0%, transparent 70%);
    animation: floatAurora3 26s ease-in-out infinite alternate;
  }

  @keyframes floatAurora1 {
    0% { transform: translate(0, 0) scale(1); opacity: 0.08; }
    50% { transform: translate(45px, 35px) scale(1.12); opacity: 0.14; }
    100% { transform: translate(-35px, 50px) scale(0.96); opacity: 0.09; }
  }

  @keyframes floatAurora2 {
    0% { transform: translate(0, 0) scale(1); opacity: 0.07; }
    50% { transform: translate(-45px, -35px) scale(1.14); opacity: 0.12; }
    100% { transform: translate(35px, 40px) scale(0.92); opacity: 0.06; }
  }

  @keyframes floatAurora3 {
    0% { transform: translate(0, 0) scale(1); opacity: 0.08; }
    50% { transform: translate(35px, -35px) scale(1.1); opacity: 0.13; }
    100% { transform: translate(-40px, 25px) scale(0.98); opacity: 0.07; }
  }
</style>

<script>
  function initParticleCanvas() {
    const canvas = document.getElementById("bg-particle-canvas") as HTMLCanvasElement | null;
    const glow = document.getElementById("cursor-glow");
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animId = 0;
    let isVisible = true;

    // Sichqoncha koordinatalari
    const mouse = { x: -1000, y: -1000, radius: 110 };

    const handleMouseMove = (e: MouseEvent) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;

      if (glow && window.innerWidth >= 768) {
        glow.style.left = e.clientX + "px";
        glow.style.top = e.clientY + "px";
      }
    };

    const handleMouseLeave = () => {
      mouse.x = -1000;
      mouse.y = -1000;
    };

    window.addEventListener("mousemove", handleMouseMove, { passive: true });
    window.addEventListener("mouseleave", handleMouseLeave, { passive: true });

    // Zarrachalar strukturasi
    interface Particle {
      x: number;
      y: number;
      size: number;
      speedX: number;
      speedY: number;
      color: string;
      alpha: number;
      baseAlpha: number;
      alphaSpeed: number;
      glow: boolean;
    }

    let particles: Particle[] = [];

    // Tiniq oppoq va elektr yalpiz ranglar palitrasi
    const colorPalette = [
      "rgba(78, 237, 184, ",  // Elektr Yalpiz #4EEDB8
      "rgba(95, 254, 196, ",  // Neon Tsian #5FFEC4
      "rgba(255, 255, 255, ", // Tiniq Oppoq #FFFFFF
      "rgba(0, 245, 160, ",   // Och Yashil-Yalpiz #00F5A0
    ];

    let isMobile = false;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      isMobile = width < 640;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);

      // Mobilda kamroq, desktopda to'liqroq (Mobilda batareya va GPU tejaladi)
      const count = Math.floor((width * height) / (isMobile ? 36000 : 24000));
      const total = isMobile ? Math.min(Math.max(count, 18), 28) : Math.min(Math.max(count, 35), 65);

      particles = [];
      for (let i = 0; i < total; i++) {
        const baseColor = colorPalette[Math.floor(Math.random() * colorPalette.length)];
        const isWhite = baseColor.includes("255, 255, 255");
        const size = Math.random() < 0.2 ? (Math.random() * 1.1 + 1.8) : (Math.random() * 0.9 + 0.9);
        const baseAlpha = isWhite ? (Math.random() * 0.35 + 0.25) : (Math.random() * 0.45 + 0.3);

        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          size,
          speedX: (Math.random() - 0.5) * 0.2, // Juda sokin gorizontal harakat
          speedY: -(Math.random() * 0.3 + 0.08), // Sekin va mayin yuqoriga ko'tarilish
          color: baseColor,
          alpha: baseAlpha,
          baseAlpha,
          alphaSpeed: Math.random() * 0.012 + 0.004,
          glow: size > 1.6,
        });
      }
    };

    resize();
    window.addEventListener("resize", resize, { passive: true });

    // Animatsiya render tsikli (60 FPS)
    function render() {
      if (!ctx) return;
      if (!isVisible) {
        animId = requestAnimationFrame(render);
        return;
      }

      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        // Miltillash (Sokin Twinkle)
        p.alpha += p.alphaSpeed;
        if (p.alpha > p.baseAlpha + 0.22 || p.alpha < p.baseAlpha - 0.18) {
          p.alphaSpeed = -p.alphaSpeed;
        }

        // Harakatlanish
        p.x += p.speedX;
        p.y += p.speedY;

        // Ekranning yuqori chegarasidan o'tsa, pastdan chiqish
        if (p.y < -10) {
          p.y = height + 10;
          p.x = Math.random() * width;
        }
        if (p.x < -10) p.x = width + 10;
        if (p.x > width + 10) p.x = -10;

        let drawX = p.x;
        let drawY = p.y;
        let currentAlpha = Math.max(0.1, Math.min(p.alpha, 0.85));

        // Faqat desktopda sichqonchaga reaksiyani hisoblash
        if (!isMobile && mouse.x > 0) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < mouse.radius) {
            const force = (mouse.radius - dist) / mouse.radius;
            const angle = Math.atan2(dy, dx);
            drawX += Math.cos(angle) * force * 16;
            drawY += Math.sin(angle) * force * 16;
            currentAlpha = Math.min(1, currentAlpha + force * 0.35);
          }
        }

        // Zarrachani chizish
        ctx.beginPath();
        ctx.arc(drawX, drawY, p.size, 0, Math.PI * 2);

        if (p.glow && !isMobile) {
          ctx.shadowBlur = 6;
          ctx.shadowColor = "#4EEDB8";
        } else {
          ctx.shadowBlur = 0;
        }

        ctx.fillStyle = `${p.color}${currentAlpha})`;
        ctx.fill();
      }

      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);

    // Tab yopilganda yoki fon rejimida batareya va quvvatni tejash
    document.addEventListener("visibilitychange", () => {
      isVisible = !document.hidden;
      if (isVisible) {
        animId = requestAnimationFrame(render);
      } else if (animId) {
        cancelAnimationFrame(animId);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initParticleCanvas);
  } else {
    initParticleCanvas();
  }
</script>

