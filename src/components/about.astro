---
---

<section id="about" class="py-16 sm:py-24 border-t border-white/10 text-[var(--white)]">
  <div class="space-y-12">
    
    <!-- Section Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--sec)]/10 text-[var(--sec)] text-xs font-semibold tracking-wider uppercase">
        <span>Tanishuv</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
        Men haqimda
      </h2>
      <p class="text-base text-gray-400 max-w-2xl">
        Dasturlash, pedagogik mahorat va zamonaviy innovatsion texnologiyalarni uyg‘unlashtirgan faoliyat yo‘lim.
      </p>
    </div>

    <!-- Main About Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Biography & Philosophy -->
      <div class="lg:col-span-7 space-y-6">
        
        <div class="glass-card p-6 sm:p-8 rounded-2xl space-y-4">
          <h3 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--sec)]"></span>
            Kasbiy qiyofa va shaxsiy qarashlar
          </h3>
          <p class="text-sm sm:text-base text-gray-300 leading-relaxed">
            Men — <strong class="text-white">Shamsiddinov Muxiddin Xusniddin o‘g‘li</strong>, O‘zbekistonning Sirdaryo viloyatida faoliyat olib boruvchi IT mutaxassisi, dasturchi va pedagogman. Asosiy yo‘nalishim veb-dasturlash, Telegram botlar ishlab chiqish, zamonaviy axborot texnologiyalarini chuqur o‘rganish va yosh avlodga dasturlash sirlarini tizimli o‘rgatish bilan bog‘liq.
          </p>
          <p class="text-sm sm:text-base text-gray-300 leading-relaxed">
            Hozirda Guliston shahridagi <strong class="text-[var(--sec)]">Rich Boss xususiy maktabida</strong> bo‘lajak dasturchilarga dars berib kelmoqdaman. O‘quvchilarga dasturlashni quruq nazariya emas, balki tushunarli, amaliy va loyihalarga asoslangan zamonaviy usullarda o‘rgatish, ularning mustaqil fikrlashi hamda real dasturiy yechimlar yaratishini qo‘llab-quvvatlayman.
          </p>
          <p class="text-sm sm:text-base text-gray-300 leading-relaxed">
            Shuningdek, Sirdaryo Ilg‘or Kasbiy Mahorat Texnikumida maxsus fan o‘qituvchisi hamda Guliston davlat pedagogika institutida muhandis-elektronchi sifatida texnik jarayonlarni boshqarishda tajriba to‘plaganman.
          </p>
        </div>

        <!-- Philosophy Highlight Box -->
        <div class="p-6 rounded-2xl bg-gradient-to-r from-[var(--sec)]/15 via-[#38bdf8]/10 to-transparent border border-[var(--sec)]/30 space-y-3">
          <div class="flex items-center gap-2 text-[var(--sec)] text-sm font-bold uppercase tracking-wider">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            <span>Dasturlash Falsafam</span>
          </div>
          <blockquote class="text-base sm:text-lg font-medium text-white italic leading-relaxed">
            "Men uchun dasturlash — faqat kod yozish emas. Bu muammolarni tahlil qilish, samarali yechim topish, yangi g‘oyalarni amalga oshirish va insonlar uchun foydali raqamli mahsulotlar yaratish jarayonidir."
          </blockquote>
          <p class="text-xs text-gray-400">
            Maqsadim: zamonaviy texnologiyalarni chuqur o‘rganish, dasturchilik va pedagoglik tajribamni birlashtirish hamda O‘zbekistonda IT ta’limi va raqamli rivojlanishga munosib hissa qo‘shish.
          </p>
        </div>

      </div>

      <!-- Right Column: Education, Languages & Personal Interests -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Education Card -->
        <div class="glass-card p-6 rounded-2xl space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-[var(--sec)]">
                <path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"/>
              </svg>
              <span>Ta'lim</span>
            </h3>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-cyan-500/15 text-cyan-400 border border-cyan-500/30">
              4-kurs (2026)
            </span>
          </div>

          <div class="space-y-2 border-l-2 border-white/10 pl-4 py-1">
            <h4 class="text-base font-semibold text-white">Guliston davlat pedagogika instituti</h4>
            <p class="text-xs sm:text-sm text-gray-300">Aniq va tabiiy fanlar fakulteti</p>
            <p class="text-xs text-gray-400">Yo‘nalish: <strong>Matematika va informatika</strong> (Bakalavriat, kunduzgi)</p>
            <p class="text-xs text-gray-500">Qabul yili: 2023-yil | Matematika, mantiqiy algoritmlar va axborot texnologiyalari uyg‘unligi.</p>
          </div>
        </div>

        <!-- Languages & Global Mindset -->
        <div class="glass-card p-6 rounded-2xl space-y-4">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-emerald-400">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
            </svg>
            <span>Til bilish darajasi</span>
          </h3>

          <div class="space-y-3">
            <div class="space-y-1">
              <div class="flex justify-between text-xs font-medium">
                <span class="text-white">O‘zbek tili</span>
                <span class="text-emerald-400">Ona tili (Native)</span>
              </div>
              <div class="h-2 w-full bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-400 rounded-full w-full"></div>
              </div>
            </div>

            <div class="space-y-1">
              <div class="flex justify-between text-xs font-medium">
                <span class="text-white">Turk tili</span>
                <span class="text-[var(--sec)]">B2 darajasi (Erkin muloqot)</span>
              </div>
              <div class="h-2 w-full bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-[var(--sec)] rounded-full w-[80%]"></div>
              </div>
            </div>

            <div class="space-y-1">
              <div class="flex justify-between text-xs font-medium">
                <span class="text-white">Ingliz & Rus tili</span>
                <span class="text-cyan-400">Texnik IT & Hujjatlar</span>
              </div>
              <div class="h-2 w-full bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-cyan-400 rounded-full w-[65%]"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Additional Interests Card -->
        <div class="glass-card p-6 rounded-2xl space-y-3">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-amber-400">
              <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
            </svg>
            <span>Qo‘shimcha qiziqishlarim</span>
          </h3>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            Dasturlashdan tashqari, <strong>zamonaviy kompyuter texnikasi, protsessorlar va videokartalar arxitekturasi</strong>, apparat samaradorligini oshirish, veb-dizayn, raqamli marketing, brending va Telegram botlar uchun foydalanuvchiga qulay grafik interfeyslar (UI) ishlab chiqishga katta qiziqish bilan qarayman.
          </p>
          <div class="flex flex-wrap gap-2 pt-1">
            <span class="text-[11px] px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-gray-300">Hardware & CPU/GPU</span>
            <span class="text-[11px] px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-gray-300">UI/UX Dizayn</span>
            <span class="text-[11px] px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-gray-300">Raqamli Brending</span>
            <span class="text-[11px] px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-gray-300">Mantiqiy Masalalar</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
