---
import SkillsList from "../React/SkillsList.tsx";
---

<section id="skills" class="py-16 sm:py-24 border-t border-orange-500/15 text-white relative">
  <div class="space-y-10">
    
    <!-- Clean Section Header (GSAP Reveal) -->
    <div class="space-y-2 section-header">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/25 text-orange-400 text-xs font-semibold tracking-wider uppercase">
        <span class="w-2 h-2 rounded-full bg-orange-400 animate-pulse"></span>
        <span>Texnik salohiyat</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Ko‘nikmalar va Stack
      </h2>
      <p class="text-sm sm:text-base text-slate-400 max-w-2xl">
        Frontend veb-dasturlash, asinxron Telegram botlar, ma’lumotlar bazasi va pedagogik metodikalar.
      </p>
    </div>

    <!-- Interactive Skills Component (Powered by Motion / Framer Motion) -->
    <SkillsList client:load />

    <!-- 3 Core Competency Cards (GSAP Reveal & Tilt) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-2">
      
      <div class="reveal-card tilt-card cyber-card p-5 sm:p-6 rounded-2xl bg-[#08080e]/90 border-orange-500/20 space-y-3">
        <div class="w-10 h-10 rounded-xl bg-orange-500/15 text-orange-400 flex items-center justify-center font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
          </svg>
        </div>
        <h4 class="text-base font-bold text-white">Amaliy Loyihaviy Ta'lim</h4>
        <p class="text-xs text-slate-300 leading-relaxed">
          Rich Boss maktabi va texnikumdagi darslarda o‘quvchilarga tayyor javobni emas, balki real muammolarni tahlil qilish va dasturiy yechimini topishni o‘rgataman.
        </p>
      </div>

      <div class="reveal-card tilt-card cyber-card p-5 sm:p-6 rounded-2xl bg-[#08080e]/90 border-orange-500/20 space-y-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500/15 text-amber-300 flex items-center justify-center font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.04-.75 4.07-1.77 6.78-2.94 8.14-3.51 3.87-1.62 4.67-1.9 5.2-1.91.12 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.19-.04.35z"/>
          </svg>
        </div>
        <h4 class="text-base font-bold text-white">Telegram Bot Arxitekturasi</h4>
        <p class="text-xs text-slate-300 leading-relaxed">
          Aiogram 3 yordamida tezkor, asinxron va ma'lumotlar bazasi (SQLite) bilan mustahkam bog‘langan xavfsiz avtomatlashtirish botlari ishlab chiqish.
        </p>
      </div>

      <div class="reveal-card tilt-card cyber-card p-5 sm:p-6 rounded-2xl bg-[#08080e]/90 border-orange-500/20 space-y-3">
        <div class="w-10 h-10 rounded-xl bg-orange-500/15 text-orange-400 flex items-center justify-center font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M4 6h16v12H4z"/>
          </svg>
        </div>
        <h4 class="text-base font-bold text-white">Apparat & Tizimli Samaradorlik</h4>
        <p class="text-xs text-slate-300 leading-relaxed">
          Muhandis-elektronchi tajribasi tufayli nafaqat dasturiy ta'minot, balki kompyuter qurilmalari, protsessorlar va elektronika asoslarini chuqur bilaman.
        </p>
      </div>

    </div>

  </div>
</section>
