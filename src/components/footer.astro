---
import LikeButton from "../React/LikeButton.tsx";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentYear = new Date().getFullYear();
---

<footer class="w-full pt-10 pb-12 border-t border-[#4EEDB8]/15 text-slate-400 relative">
  <div class="space-y-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center justify-between">
      
      <!-- Left: Brand & Info -->
      <div class="md:col-span-5 space-y-1.5 text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-3">
          <div class="w-9 h-9 rounded-xl overflow-hidden ring-1 ring-[#4EEDB8]/40 shadow-[0_0_12px_rgba(78,237,184,0.25)]">
            <img
              src={`${baseUrl}/images/profile.jpg`}
              alt="Shamsiddinov Muxiddin"
              class="w-full h-full object-cover object-top filter contrast-110"
              loading="lazy"
            />
          </div>
          <span class="text-base sm:text-lg font-extrabold text-white tracking-wide">
            MUXIDDIN<span class="text-[#4EEDB8]">.DEV</span>
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans">
          Full-Stack Web Dasturchi &middot; Aiogram 3 Bot Developer &middot; IT Pedagog
        </p>
        <p class="text-xs text-[#4EEDB8] font-medium">
          Rich Boss Xususiy Maktabi &middot; Guliston shahri, Sirdaryo
        </p>
      </div>

      <!-- Center: Social Media Links -->
      <div class="md:col-span-4 flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 text-xs">
        <a
          href="https://github.com/Muxiddin-darkcode"
          target="_blank"
          rel="noopener noreferrer"
          class="magnetic-item inline-flex items-center gap-2 px-3 sm:px-3.5 py-2 min-h-[40px] rounded-xl bg-[#060a0f] hover:bg-[#4EEDB8]/10 border border-[#4EEDB8]/20 hover:border-[#4EEDB8] text-slate-300 hover:text-white transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-[#4EEDB8]">
            <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/>
          </svg>
          <span>GitHub</span>
        </a>

        <a
          href="https://t.me/developer_muxiddin"
          target="_blank"
          rel="noopener noreferrer"
          class="magnetic-item inline-flex items-center gap-2 px-3 sm:px-3.5 py-2 min-h-[40px] rounded-xl bg-[#060a0f] hover:bg-[#4EEDB8]/10 border border-[#4EEDB8]/20 hover:border-[#4EEDB8] text-[#4EEDB8] hover:text-[#5FFEC4] transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-[#5FFEC4]">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.04-.75 4.07-1.77 6.78-2.94 8.14-3.51 3.87-1.62 4.67-1.9 5.2-1.91.12 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.19-.04.35z"/>
          </svg>
          <span>Telegram</span>
        </a>

        <a
          href="https://instagram.com/aurev.uz"
          target="_blank"
          rel="noopener noreferrer"
          class="magnetic-item inline-flex items-center gap-2 px-3 sm:px-3.5 py-2 min-h-[40px] rounded-xl bg-[#060a0f] hover:bg-[#4EEDB8]/10 border border-[#4EEDB8]/20 hover:border-[#4EEDB8] text-slate-300 hover:text-white transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-[#4EEDB8]">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Instagram</span>
        </a>
      </div>

      <!-- Right: LikeButton & Yuqoriga -->
      <div class="md:col-span-3 flex items-center justify-center md:justify-end gap-3 text-xs">
        <LikeButton client:idle />
        <a
          href="#home"
          class="magnetic-item h-9 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-[#060a0f] hover:bg-[#4EEDB8]/10 border border-[#4EEDB8]/20 hover:border-[#4EEDB8] text-slate-300 hover:text-[#4EEDB8] transition-all cursor-pointer shadow-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-[#4EEDB8]">
            <path fill-rule="evenodd" d="M10 17a.75.75 0 01-.75-.75V5.612L5.29 9.77a.75.75 0 01-1.08-1.04l5.25-5.5a.75.75 0 011.08 0l5.25 5.5a.75.75 0 11-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0110 17z" clip-rule="evenodd" />
          </svg>
          <span>Yuqoriga</span>
        </a>
      </div>

    </div>

    <!-- Bottom Copyright Line -->
    <div class="pt-6 border-t border-[#4EEDB8]/10 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-3 text-center">
      <p>
        &copy; {currentYear} Shamsiddinov Muxiddin Xusniddin o‘g‘li. Barcha huquqlar himoyalangan.
      </p>
      <p class="text-xs text-[#4EEDB8] font-medium font-mono">
        Professional Full-Stack Portfolio
      </p>
    </div>

  </div>
</footer>
