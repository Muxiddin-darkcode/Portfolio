---
---

<section id="contact" class="py-16 sm:py-24 border-t border-white/10 text-[var(--white)]">
  <div class="space-y-12">
    
    <!-- Section Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--sec)]/10 text-[var(--sec)] text-xs font-semibold tracking-wider uppercase">
        <span>Muloqot</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
        Bog‘lanish
      </h2>
      <p class="text-base text-gray-400 max-w-xl">
        Yangi loyihalar, veb-saytlar, Telegram botlar ishlab chiqish yoki IT ta’limi bo‘yicha takliflaringiz bo‘lsa, bemalol murojaat qiling!
      </p>
    </div>

    <!-- Contact Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Contact Info Cards -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Location Card -->
        <div class="glass-card p-5 sm:p-6 rounded-2xl flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-[var(--sec)] flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
              <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-gray-400">Manzil</h4>
            <p class="text-base font-bold text-white mt-0.5">Guliston shahri, Sirdaryo viloyati</p>
            <p class="text-xs text-gray-500">O‘zbekiston Respublikasi</p>
          </div>
        </div>

        <!-- Telegram Card -->
        <a
          href="https://t.me/developer_muxiddin"
          target="_blank"
          rel="noopener noreferrer"
          class="glass-card p-5 sm:p-6 rounded-2xl flex items-start gap-4 group hover:border-[#38bdf8]/40 transition-all block"
        >
          <div class="w-12 h-12 rounded-xl bg-[#38bdf8]/10 border border-[#38bdf8]/20 flex items-center justify-center text-[#38bdf8] flex-shrink-0 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.04-.75 4.07-1.77 6.78-2.94 8.14-3.51 3.87-1.62 4.67-1.9 5.2-1.91.12 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.19-.04.35z"/>
            </svg>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-gray-400">Telegram orqali tezkor aloqa</h4>
            <p class="text-base font-bold text-white mt-0.5 group-hover:text-[#38bdf8] transition-colors">@developer_muxiddin</p>
            <p class="text-xs text-gray-500">Murojaat uchun doim ochiq</p>
          </div>
        </a>

        <!-- Instagram Card -->
        <a
          href="https://instagram.com/aurev.uz"
          target="_blank"
          rel="noopener noreferrer"
          class="glass-card p-5 sm:p-6 rounded-2xl flex items-start gap-4 group hover:border-pink-500/40 transition-all block"
        >
          <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-pink-500/10 via-purple-500/10 to-amber-500/10 border border-pink-500/20 flex items-center justify-center text-pink-400 flex-shrink-0 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-gray-400">Instagram sahifasi</h4>
            <p class="text-base font-bold text-white mt-0.5 group-hover:text-pink-400 transition-colors">@aurev.uz</p>
            <p class="text-xs text-gray-500">Ijtimoiy tarmoq & hayotiy lavhalar</p>
          </div>
        </a>

        <!-- GitHub Profile Card -->
        <a
          href="https://github.com/Muxiddin-darkcode"
          target="_blank"
          rel="noopener noreferrer"
          class="glass-card p-5 sm:p-6 rounded-2xl flex items-start gap-4 group hover:border-[var(--sec)]/40 transition-all block"
        >
          <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white flex-shrink-0 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
              <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/>
            </svg>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-gray-400">GitHub Repozitoriylar</h4>
            <p class="text-base font-bold text-white mt-0.5 group-hover:text-[var(--sec)] transition-colors">Muxiddin-darkcode</p>
            <p class="text-xs text-gray-500">Raqamli profil: INFOGENIUZ</p>
          </div>
        </a>

      </div>

      <!-- Contact Message Form -->
      <div class="lg:col-span-7 glass-card p-6 sm:p-8 rounded-2xl space-y-6">
        <h3 class="text-xl font-bold text-white">Xabar yuborish</h3>
        
        <form
          id="contact-form"
          action="https://formspree.io/f/xbjnyqvo"
          method="POST"
          class="space-y-4"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="text-xs font-semibold text-gray-400">Ismingiz</label>
              <input
                type="text"
                name="name"
                placeholder="Jasurbek / Ismingiz"
                required
                class="w-full px-4 py-3 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] text-sm transition-all"
              />
            </div>
            
            <div class="space-y-1.5">
              <label class="text-xs font-semibold text-gray-400">Email yoki Telegram username</label>
              <input
                type="text"
                name="contact_info"
                placeholder="@username yoki email"
                required
                class="w-full px-4 py-3 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] text-sm transition-all"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-semibold text-gray-400">Loyiha mavzusi / Maqsad</label>
            <input
              type="text"
              name="subject"
              placeholder="Masalan: Veb-sayt buyurtmasi / Telegram bot / Darslar"
              class="w-full px-4 py-3 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] text-sm transition-all"
            />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-semibold text-gray-400">Xabar matni</label>
            <textarea
              name="message"
              placeholder="Loyihangiz yoki taklifingiz haqida batafsil yozing..."
              rows="5"
              required
              class="w-full px-4 py-3 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] text-sm resize-none transition-all"
            ></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit-btn"
            class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-[var(--sec)] to-[#8b5cf6] text-white font-semibold text-sm shadow-lg shadow-[var(--sec)]/20 hover:shadow-xl hover:scale-[1.01] active:scale-[0.99] transition-all duration-200 flex items-center justify-center gap-2"
          >
            <span>Xabarni yuborish</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
              <path d="M3.105 2.289a.75.75 0 00-.826.95l1.414 4.925A1.5 1.5 0 004.996 9.25h4.254a.75.75 0 010 1.5H4.996a1.5 1.5 0 00-1.303 1.086l-1.414 4.925a.75.75 0 00.99.932l14-7.5a.75.75 0 000-1.324l-14-7.5z" />
            </svg>
          </button>
        </form>

        <div
          id="contact-success-msg"
          class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-medium text-center"
        >
          ✅ Rahmat! Xabaringiz qabul qilindi. Tez orada javob beraman.
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  const contactForm = document.getElementById("contact-form");
  const successMsg = document.getElementById("contact-success-msg");

  contactForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById("contact-submit-btn");
    if (submitBtn) submitBtn.textContent = "Yuborilmoqda...";

    const formData = new FormData(contactForm);

    try {
      const response = await fetch(contactForm.action, {
        method: "POST",
        body: formData,
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        contactForm.reset();
        contactForm.style.display = "none";
        successMsg?.classList.remove("hidden");
      } else {
        alert("Xabar yuborildi! Siz bilan tez orada bog'lanamiz.");
        contactForm.reset();
      }
    } catch (err) {
      // In case of offline or cross-origin
      contactForm.reset();
      contactForm.style.display = "none";
      successMsg?.classList.remove("hidden");
    } finally {
      if (submitBtn) submitBtn.textContent = "Xabarni yuborish";
    }
  });
</script>
