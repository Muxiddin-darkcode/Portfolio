---
---

<section id="contact" class="py-16 sm:py-24 border-t border-[#4EEDB8]/20 text-white relative">
  <div class="space-y-10">
    
    <!-- Section Header (GSAP Reveal) -->
    <div class="space-y-2 section-header">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#4EEDB8]/10 border border-[#4EEDB8]/30 text-[#4EEDB8] text-xs font-semibold tracking-wider uppercase font-mono shadow-[0_0_12px_rgba(78,237,184,0.15)]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
          <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z" />
          <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z" />
        </svg>
        <span>Muloqot va hamkorlik</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        To‘g‘ridan-to‘g‘ri <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-[#4EEDB8] to-[#5FFEC4]">Bog‘lanish</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-300 max-w-xl leading-relaxed">
        Yangi veb-loyihalar, Telegram botlar yoki ta’lim yo‘nalishidagi hamkorlik bo‘yicha to‘g‘ridan-to‘g‘ri aloqa.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Contact Info Cards (Left Column) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Telegram Card (Magnetic) -->
        <a
          href="https://t.me/developer_muxiddin"
          target="_blank"
          rel="noopener noreferrer"
          class="magnetic-item p-5 rounded-2xl flex items-start gap-4 bg-[#060a0f]/95 border border-[#4EEDB8]/25 hover:border-[#4EEDB8] hover:shadow-[0_0_20px_rgba(78,237,184,0.25)] transition-all group block cursor-pointer"
        >
          <div class="w-11 h-11 rounded-xl bg-[#4EEDB8]/10 border border-[#4EEDB8]/30 flex items-center justify-center text-[#4EEDB8] flex-shrink-0 group-hover:scale-110 transition-transform shadow-[0_0_12px_rgba(78,237,184,0.2)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.04-.75 4.07-1.77 6.78-2.94 8.14-3.51 3.87-1.62 4.67-1.9 5.2-1.91.12 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.19-.04.35z"/>
            </svg>
          </div>
          <div>
            <div class="text-[11px] text-[#4EEDB8] font-mono font-semibold uppercase tracking-wider">Tezkor aloqa</div>
            <p class="text-sm sm:text-base font-semibold text-white mt-0.5 group-hover:text-[#4EEDB8] transition-colors">
              @developer_muxiddin
            </p>
            <p class="text-xs text-slate-400">Telegram orqali to‘g‘ridan-to‘g‘ri bog‘lanish</p>
          </div>
        </a>

        <!-- Location Card -->
        <div class="p-5 rounded-2xl flex items-start gap-4 bg-[#060a0f]/95 border border-[#4EEDB8]/20">
          <div class="w-11 h-11 rounded-xl bg-[#4EEDB8]/10 border border-[#4EEDB8]/25 flex items-center justify-center text-[#4EEDB8] flex-shrink-0 shadow-[0_0_10px_rgba(78,237,184,0.15)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <div class="text-[11px] text-[#4EEDB8] font-mono font-semibold uppercase tracking-wider">Manzil</div>
            <p class="text-sm sm:text-base font-semibold text-white mt-0.5">Guliston shahri, Sirdaryo</p>
            <p class="text-xs text-slate-400">O‘zbekiston Respublikasi</p>
          </div>
        </div>

        <!-- Phone Card -->
        <div class="p-5 rounded-2xl flex items-start gap-4 bg-[#060a0f]/95 border border-[#4EEDB8]/20">
          <div class="w-11 h-11 rounded-xl bg-[#4EEDB8]/10 border border-[#4EEDB8]/25 flex items-center justify-center text-[#4EEDB8] flex-shrink-0 shadow-[0_0_10px_rgba(78,237,184,0.15)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <div class="text-[11px] text-[#4EEDB8] font-mono font-semibold uppercase tracking-wider">Telefon raqam</div>
            <p class="text-sm sm:text-base font-semibold text-white mt-0.5 font-mono">+998 (97) 127-14-11</p>
            <p class="text-xs text-slate-400">Qo‘ng‘iroqlar va SMS xabarlar uchun</p>
          </div>
        </div>

      </div>

      <!-- Clean Form Card (Right Column with Magnetic Button) -->
      <div class="reveal-card lg:col-span-7 p-4 sm:p-7 lg:p-8 rounded-2xl bg-[#060a0f]/95 border border-[#4EEDB8]/25 shadow-[0_20px_50px_rgba(0,0,0,0.9),0_0_25px_rgba(78,237,184,0.12)] space-y-5 sm:space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-[#4EEDB8]/15">
          <h3 class="text-base sm:text-lg font-bold text-white">Xabar qoldirish</h3>
          <span class="text-xs text-[#4EEDB8] bg-[#4EEDB8]/10 px-2.5 py-0.5 rounded-full border border-[#4EEDB8]/30 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#5FFEC4] animate-pulse"></span>
            Online
          </span>
        </div>
        
        <form
          id="contact-form"
          action="https://formspree.io/f/xbjnyqvo"
          method="POST"
          class="space-y-4 text-xs sm:text-sm"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4">
            <div class="space-y-1.5">
              <label class="text-slate-300 font-medium block">Ismingiz <span class="text-[#4EEDB8]">*</span></label>
              <input
                type="text"
                name="name"
                placeholder="Jasurbek"
                required
                class="w-full px-3.5 sm:px-4 py-3 rounded-xl bg-[#0c141d] border border-[#4EEDB8]/20 text-white placeholder-slate-500 focus:outline-none focus:border-[#4EEDB8] focus:shadow-[0_0_12px_rgba(78,237,184,0.25)] text-base sm:text-sm transition-all"
              />
            </div>
            
            <div class="space-y-1.5">
              <label class="text-slate-300 font-medium block">Telegram yoki Email <span class="text-[#4EEDB8]">*</span></label>
              <input
                type="text"
                name="contact_info"
                placeholder="@username yoki email"
                required
                class="w-full px-3.5 sm:px-4 py-3 rounded-xl bg-[#0c141d] border border-[#4EEDB8]/20 text-white placeholder-slate-500 focus:outline-none focus:border-[#4EEDB8] focus:shadow-[0_0_12px_rgba(78,237,184,0.25)] text-base sm:text-sm transition-all"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label class="text-slate-300 font-medium block">Loyiha mavzusi</label>
            <input
              type="text"
              name="subject"
              placeholder="Veb-sayt, Telegram bot yoki taklif"
              class="w-full px-3.5 sm:px-4 py-3 rounded-xl bg-[#0c141d] border border-[#4EEDB8]/20 text-white placeholder-slate-500 focus:outline-none focus:border-[#4EEDB8] focus:shadow-[0_0_12px_rgba(78,237,184,0.25)] text-base sm:text-sm transition-all"
            />
          </div>

          <div class="space-y-1.5">
            <label class="text-slate-300 font-medium block">Xabaringiz <span class="text-[#4EEDB8]">*</span></label>
            <textarea
              name="message"
              placeholder="Loyiha tavsifi, talablar yoki taklifingiz haqida yozing..."
              rows="4"
              required
              class="w-full px-3.5 sm:px-4 py-3 rounded-xl bg-[#0c141d] border border-[#4EEDB8]/20 text-white placeholder-slate-500 focus:outline-none focus:border-[#4EEDB8] focus:shadow-[0_0_12px_rgba(78,237,184,0.25)] text-base sm:text-sm resize-none transition-all"
            ></textarea>
          </div>

          <!-- Magnetic Shiny Submit Button -->
          <button
            type="submit"
            id="contact-submit-btn"
            class="magnetic-btn btn-shine w-full py-3.5 px-6 rounded-xl min-h-[48px] bg-gradient-to-r from-[#00F5A0] via-[#4EEDB8] to-[#5FFEC4] text-[#02130c] font-bold text-sm shadow-[0_0_20px_rgba(78,237,184,0.35)] hover:shadow-[0_0_25px_rgba(78,237,184,0.5)] active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer select-none"
          >
            <span class="magnetic-text flex items-center justify-center gap-2">
              <span id="submit-btn-text">Xabarni yuborish</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                <path d="M3.105 2.289a.75.75 0 00-.826.95l1.414 4.925A1.5 1.5 0 004.996 9.25h4.254a.75.75 0 010 1.5H4.996a1.5 1.5 0 00-1.303 1.086l-1.414 4.925a.75.75 0 00.99.932l14-7.5a.75.75 0 000-1.324l-14-7.5z" />
              </svg>
            </span>
          </button>
        </form>

        <div
          id="contact-success-msg"
          class="hidden p-5 rounded-xl bg-[#4EEDB8]/15 border border-[#4EEDB8]/40 text-[#4EEDB8] text-xs sm:text-sm font-semibold text-center space-y-2 shadow-[0_0_20px_rgba(78,237,184,0.2)]"
        >
          <div class="text-xl">✓</div>
          <div>Rahmat! Xabaringiz muvaffaqiyatli qabul qilindi.</div>
          <div class="text-xs text-[#4EEDB8]/80 font-normal">Tez orada siz bilan bog‘lanaman.</div>
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  const contactForm = document.getElementById("contact-form");
  const successMsg = document.getElementById("contact-success-msg");
  const submitBtnText = document.getElementById("submit-btn-text");

  contactForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (submitBtnText) submitBtnText.textContent = "Yuborilmoqda...";

    const formData = new FormData(contactForm);

    try {
      const response = await fetch(contactForm.action, {
        method: "POST",
        body: formData,
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        contactForm.reset();
        contactForm.style.display = "none";
        successMsg?.classList.remove("hidden");
      } else {
        contactForm.reset();
        contactForm.style.display = "none";
        successMsg?.classList.remove("hidden");
      }
    } catch (err) {
      contactForm.reset();
      contactForm.style.display = "none";
      successMsg?.classList.remove("hidden");
    } finally {
      if (submitBtnText) submitBtnText.textContent = "Xabarni yuborish";
    }
  });
</script>
