---
interface WorkExperience {
  period: string;
  role: string;
  company: string;
  location: string;
  type: string;
  desc: string;
  isCurrent?: boolean;
}

const experiences: WorkExperience[] = [
  {
    period: "Hozirgi vaqtda",
    role: "Dasturlash yo‘nalishida IT o‘qituvchi",
    company: "Rich Boss xususiy maktabi",
    location: "Guliston shahri, O‘zbekiston",
    type: "Asosiy faoliyat",
    desc: "Bo‘lajak dasturchilarga dasturlash asoslarini o‘rgatish, algoritmik va mantiqiy fikrlashni rivojlantirish. Nazariy bilimlarni amaliy mashg‘ulotlar va mustaqil dasturiy loyihalar bilan mustahkamlash.",
    isCurrent: true,
  },
  {
    period: "2026-yil 4-sentabr – 9-oktabr",
    role: "Informatika fani o‘qituvchisi",
    company: "Guliston shahar 8-sonli umumiy o‘rta ta’lim maktabi",
    location: "Guliston shahri",
    type: "Ta'lim berish",
    desc: "Maktab o‘quvchilariga informatika fani bo‘yicha zamonaviy dasturlar, kompyuter savodxonligi va axborot texnologiyalari asoslaridan dars berish.",
  },
  {
    period: "2025-yil 17-oktabr – 2026-yil 26-avgust",
    role: "O‘qituvchi (Maxsus fanlar)",
    company: "Sirdaryo Ilg‘or Kasbiy Mahorat Texnikumi",
    location: "Sirdaryo viloyati",
    type: "O‘rindoshlik asosida",
    desc: "Kasbiy ta’lim va maxsus axborot texnologiyalari fanlarini o‘qitish, kompyuter qurilmalari, apparat ta'minoti va amaliy dasturlash bo‘yicha o‘quv materiallari bilan ishlash.",
  },
  {
    period: "2025-yil 3-sentabr – 22-oktabr",
    role: "O‘qituvchi",
    company: "Sirdaryo pedagogika texnikumi",
    location: "Sirdaryo viloyati",
    type: "Tashqi o‘rindoshlik",
    desc: "Bo‘lajak pedagoglarga axborot texnologiyalari va raqamli ta'lim vositalari bo‘yicha dars berish.",
  },
  {
    period: "2024-yil 26-noyabr – 2026-yil 23-yanvar",
    role: "Birinchi toifali muhandis-elektronchi",
    company: "Guliston davlat pedagogika instituti (GDPI)",
    location: "Texnik qo‘llab-quvvatlash bo‘limi",
    type: "Muhandislik faoliyati",
    desc: "Texnik qurilmalar va elektron uskunalar bilan ishlash, server va tarmoq infratuzilmasiga texnik yordam ko‘rsatish hamda oliygohdagi raqamli texnik jarayonlarni boshqarish.",
  },
  {
    period: "2024-yil 16-noyabr – 2-dekabr",
    role: "Ip yigiruv uskunalarining urchuqlarini yig‘uvchi",
    company: "FORTUNA TEKSTIL qo‘shma korxonasi",
    location: "Sirdaryo viloyati",
    type: "Ishlab chiqarish tajribasi",
    desc: "Sanoat texnikasi bilan ishlash, yuqori mas'uliyat, diqqat va jamoaviy mehnat intizomini shakllantirish tajribasi.",
  },
];
---

<section id="experience" class="py-16 sm:py-24 border-t border-[#4EEDB8]/20 text-white relative">
  <div class="space-y-10">
    
    <!-- Section Header (GSAP Reveal) -->
    <div class="space-y-2 section-header">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#4EEDB8]/10 border border-[#4EEDB8]/30 text-[#4EEDB8] text-xs font-semibold tracking-wider uppercase font-mono shadow-[0_0_12px_rgba(78,237,184,0.15)]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
          <path fill-rule="evenodd" d="M6 3.75A2.75 2.75 0 018.75 1h2.5A2.75 2.75 0 0114 3.75v.443c.572.055 1.14.122 1.706.2C17.053 4.582 18 5.75 18 7.07v3.469c0 1.126-.694 2.191-1.83 2.54-1.952.599-4.024.921-6.17.921s-4.219-.322-6.17-.921C2.694 12.73 2 11.665 2 10.539V7.07c0-1.321.947-2.489 2.294-2.676A41.047 41.047 0 016 4.193V3.75zm1.5 0V4.14c.83-.04 1.667-.06 2.5-.06s1.67.02 2.5.06V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25zM10 15.25a25.26 25.26 0 01-6.526-.853.75.75 0 00-.474 1.423A26.758 26.758 0 0010 16.75a26.758 26.758 0 007-.93.75.75 0 00-.474-1.423A25.26 25.26 0 0110 15.25z" clip-rule="evenodd" />
        </svg>
        <span>Ish tajribasi</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Mehnat faoliyati va <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-[#4EEDB8] to-[#5FFEC4]">tajribalarim</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
        Dasturlash, pedagogik mahorat hamda apparat muhandisligi yo‘nalishidagi amaliy faoliyatim.
      </p>
    </div>

    <!-- Timeline Grid (GSAP Staggered Cards) -->
    <div class="relative pl-5 sm:pl-8 border-l border-[#4EEDB8]/25 space-y-6 sm:space-y-8 my-6">
      {
        experiences.map((exp) => (
          <div class="relative group">
            
            <!-- Timeline Node Indicator -->
            <div class="absolute -left-[27px] sm:-left-[39px] top-2 flex items-center justify-center">
              {exp.isCurrent ? (
                <div class="relative flex items-center justify-center w-5 h-5">
                  <span class="absolute w-5 h-5 rounded-full bg-[#4EEDB8]/30 animate-ping"></span>
                  <span class="w-3 h-3 rounded-full bg-[#4EEDB8] shadow-[0_0_12px_#5FFEC4]"></span>
                </div>
              ) : (
                <span class="w-2.5 h-2.5 rounded-full bg-[#4EEDB8]/70 group-hover:scale-125 transition-transform group-hover:bg-[#5FFEC4] shadow-[0_0_8px_rgba(78,237,184,0.6)]"></span>
              )}
            </div>

            <!-- Experience Card (Reveal & Tilt) -->
            <div class={`reveal-card tilt-card p-4 sm:p-6 rounded-2xl bg-[#060a0f]/90 border border-[#4EEDB8]/20 hover:border-[#4EEDB8]/60 space-y-3 transition-all duration-300 hover:shadow-[0_12px_32px_-8px_rgba(78,237,184,0.22)] ${
              exp.isCurrent ? "border-[#4EEDB8]/40 shadow-[0_0_25px_rgba(78,237,184,0.15)]" : ""
            }`}>
              
              <!-- Meta Header -->
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                <div class="flex items-center gap-2">
                  <span class="text-[#4EEDB8] font-mono font-semibold">{exp.period}</span>
                </div>

                <div class="flex items-center gap-2">
                  <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-[#4EEDB8]/10 border border-[#4EEDB8]/25 text-[#4EEDB8] font-medium">
                    {exp.type}
                  </span>
                  {exp.isCurrent && (
                    <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-[#4EEDB8]/20 border border-[#4EEDB8]/40 text-[#4EEDB8] font-semibold flex items-center gap-1.5 shadow-[0_0_10px_rgba(78,237,184,0.2)]">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#5FFEC4] animate-pulse"></span>
                      Hozirgi faoliyat
                    </span>
                  )}
                </div>
              </div>

              <!-- Main Info -->
              <div class="space-y-1">
                <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-[#4EEDB8] transition-colors">
                  {exp.role}
                </h3>
                <p class="text-xs sm:text-sm text-slate-300">
                  <strong class="text-[#5FFEC4] font-semibold">{exp.company}</strong> &middot; <span class="text-slate-400">{exp.location}</span>
                </p>
              </div>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans pt-2 border-t border-[#4EEDB8]/15">
                {exp.desc}
              </p>

            </div>

          </div>
        ))
      }
    </div>

  </div>
</section>
