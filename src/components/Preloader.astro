---
// Editorial Linear / Apple Style Split-Curtain Preloader
// Kinetic Typography ("SALOM • HELLO • CREATING • MUXIDDIN.DEV") + Dual-Shutter Reveal
---

<div id="preloader-wrapper" class="fixed inset-0 z-[99999] select-none pointer-events-auto">
  
  <!-- Top Shutter Curtain -->
  <div
    id="preloader-shutter-top"
    class="absolute top-0 left-0 right-0 h-1/2 bg-[#040407] z-10 flex flex-col justify-end overflow-hidden border-b border-orange-500/20"
  >
    <!-- Ambient Warm Aura in Top Shutter -->
    <div class="absolute -bottom-36 left-1/2 -translate-x-1/2 w-[650px] h-[300px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(249,115,22,0.18)_0%,transparent_70%)] blur-3xl pointer-events-none"></div>
    <!-- Glowing Laser Line on Split Seam -->
    <div class="relative w-full h-[1.5px] bg-gradient-to-r from-transparent via-amber-400 to-transparent shadow-[0_0_15px_rgba(251,191,36,0.9)]"></div>
  </div>

  <!-- Bottom Shutter Curtain -->
  <div
    id="preloader-shutter-bottom"
    class="absolute bottom-0 left-0 right-0 h-1/2 bg-[#040407] z-10 flex flex-col justify-start overflow-hidden border-t border-orange-500/20"
  >
    <!-- Glowing Laser Line on Split Seam -->
    <div class="relative w-full h-[1.5px] bg-gradient-to-r from-transparent via-amber-400 to-transparent shadow-[0_0_15px_rgba(251,191,36,0.9)]"></div>
    <!-- Ambient Warm Aura in Bottom Shutter -->
    <div class="absolute -top-36 left-1/2 -translate-x-1/2 w-[650px] h-[300px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.14)_0%,transparent_70%)] blur-3xl pointer-events-none"></div>
  </div>

  <!-- Center Stage Container (Floating above Shutters) -->
  <div
    id="preloader-center"
    class="fixed inset-0 z-20 flex flex-col items-center justify-center px-4 pointer-events-none"
  >
    <!-- Background Soft Ambient Breathing Orb -->
    <div class="absolute w-[460px] h-[460px] rounded-full bg-[radial-gradient(circle,rgba(249,115,22,0.15)_0%,rgba(245,158,11,0.05)_45%,transparent_70%)] blur-3xl pointer-events-none"></div>

    <!-- Editorial Pill Badge -->
    <div class="relative z-10 mb-6 sm:mb-8 flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-orange-500/30 backdrop-blur-xl shadow-[0_0_20px_rgba(249,115,22,0.15)]">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse shadow-[0_0_8px_#f59e0b]"></span>
      <span class="font-mono text-[10px] sm:text-xs font-bold uppercase tracking-widest text-slate-300">
        SHAMSIDDINOV MUXIDDIN &bull; 2026
      </span>
    </div>

    <!-- Kinetic Word Greeting Carousel (Apple Style Masked Stagger) -->
    <div class="relative z-10 h-16 sm:h-20 md:h-24 w-full max-w-xl flex items-center justify-center overflow-hidden">
      
      <!-- Word 1: SALOM -->
      <div
        class="kinetic-word absolute inset-0 flex items-center justify-center text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight font-sans text-transparent bg-clip-text bg-gradient-to-b from-white via-slate-100 to-amber-200/90 drop-shadow-[0_4px_30px_rgba(255,184,0,0.3)] opacity-0 translate-y-12"
      >
        <span>SALOM</span>
        <span class="text-orange-500 ml-1">.</span>
      </div>

      <!-- Word 2: HELLO -->
      <div
        class="kinetic-word absolute inset-0 flex items-center justify-center text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight font-sans text-transparent bg-clip-text bg-gradient-to-b from-white via-slate-100 to-amber-200/90 drop-shadow-[0_4px_30px_rgba(255,184,0,0.3)] opacity-0 translate-y-12"
      >
        <span>HELLO</span>
        <span class="text-amber-400 ml-1">.</span>
      </div>

      <!-- Word 3: CREATING -->
      <div
        class="kinetic-word absolute inset-0 flex items-center justify-center text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight font-sans text-transparent bg-clip-text bg-gradient-to-b from-white via-slate-100 to-orange-300 drop-shadow-[0_4px_30px_rgba(255,107,0,0.3)] opacity-0 translate-y-12"
      >
        <span>CREATING</span>
        <span class="text-orange-400 ml-1">...</span>
      </div>

      <!-- Word 4: MUXIDDIN.DEV -->
      <div
        class="kinetic-word absolute inset-0 flex items-center justify-center text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight font-sans opacity-0 translate-y-12"
      >
        <span class="text-white drop-shadow-[0_4px_30px_rgba(255,255,255,0.3)]">Muxiddin</span>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-300 font-extrabold drop-shadow-[0_4px_25px_rgba(249,115,22,0.4)]">.dev</span>
      </div>

    </div>

    <!-- Minimal Editorial Laser Progress Line -->
    <div class="relative z-10 w-64 sm:w-80 h-[2px] bg-white/[0.08] rounded-full overflow-hidden mt-6 sm:mt-8 shadow-[inset_0_1px_3px_rgba(0,0,0,0.8)]">
      <div
        id="preloader-laser-line"
        class="absolute inset-y-0 left-0 bg-gradient-to-r from-orange-600 via-amber-400 to-yellow-200 shadow-[0_0_14px_rgba(251,191,36,0.9)] w-0"
      ></div>
    </div>

    <!-- Editorial Counter & Status Label -->
    <div class="relative z-10 flex items-center justify-between w-64 sm:w-80 mt-3 font-mono text-xs">
      <div class="flex items-center gap-1.5 text-slate-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
        <span id="preloader-status-sub" class="tracking-wider uppercase text-[10px] sm:text-[11px] text-slate-400 font-medium">
          INITIALIZING
        </span>
      </div>
      <div class="flex items-baseline gap-1 text-slate-400 font-bold">
        <span id="preloader-counter-num" class="font-mono text-base sm:text-lg text-amber-300 font-extrabold">
          000
        </span>
        <span class="text-[10px] text-orange-400/80 font-mono">/ 100</span>
      </div>
    </div>

  </div>

</div>

<!-- GSAP Driven Editorial Split Reveal Script -->
<script>
  import gsap from "gsap";

  function runEditorialPreloader() {
    const wrapper = document.getElementById("preloader-wrapper");
    const shutterTop = document.getElementById("preloader-shutter-top");
    const shutterBottom = document.getElementById("preloader-shutter-bottom");
    const centerStage = document.getElementById("preloader-center");
    const laserLine = document.getElementById("preloader-laser-line");
    const counterNum = document.getElementById("preloader-counter-num");
    const statusSub = document.getElementById("preloader-status-sub");
    const words = document.querySelectorAll(".kinetic-word");

    if (!wrapper || !shutterTop || !shutterBottom || !centerStage || words.length === 0) return;

    // Lock scrolling during preloader
    document.body.style.overflow = "hidden";

    // Master GSAP Timeline
    const tl = gsap.timeline({
      defaults: { ease: "power3.out" },
      onComplete: () => {
        // Unlock scroll
        document.body.style.overflow = "";
        wrapper.style.display = "none";
        // Dispatch completion event for hero reveal
        window.dispatchEvent(new CustomEvent("preloader:complete"));
      }
    });

    // 1. Progress Counter & Laser Line Tween (0 -> 100 in ~2.0 seconds)
    const counterObj = { val: 0 };
    tl.to(counterObj, {
      val: 100,
      duration: 2.05,
      ease: "power2.inOut",
      onUpdate: () => {
        const intVal = Math.floor(counterObj.val);
        const formatted = intVal < 10 ? `00${intVal}` : intVal < 100 ? `0${intVal}` : `${intVal}`;
        if (counterNum) counterNum.textContent = formatted;
        if (laserLine) laserLine.style.width = `${counterObj.val}%`;

        // Update subtle status subtitle
        if (statusSub) {
          if (intVal < 30) statusSub.textContent = "INITIALIZING...";
          else if (intVal < 70) statusSub.textContent = "LOADING MODULES...";
          else if (intVal < 98) statusSub.textContent = "ALMOST READY...";
          else statusSub.textContent = "WELCOME!";
        }
      }
    }, 0);

    // 2. Kinetic Words Sequence (Apple Style: Smooth Stagger Up & Out)
    const wordDuration = 0.42;

    words.forEach((word, index) => {
      const startTime = index * 0.45;
      const isLast = index === words.length - 1;

      // Animate In
      tl.fromTo(
        word,
        { opacity: 0, y: 35, scale: 0.94, filter: "blur(4px)" },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          filter: "blur(0px)",
          duration: wordDuration,
          ease: "power3.out",
        },
        startTime
      );

      // Animate Out (unless it's the last word Muxiddin.dev)
      if (!isLast) {
        tl.to(
          word,
          {
            opacity: 0,
            y: -35,
            scale: 1.05,
            filter: "blur(4px)",
            duration: 0.32,
            ease: "power3.in",
          },
          startTime + wordDuration
        );
      }
    });

    // 3. Center Stage Fade & Scale Out at 100%
    tl.to(
      centerStage,
      {
        opacity: 0,
        scale: 0.95,
        filter: "blur(6px)",
        duration: 0.38,
        ease: "power2.in",
      },
      2.12
    );

    // 4. Dual-Shutter Split Curtain Reveal (Apple / Linear Elite Exit)
    tl.to(
      shutterTop,
      {
        yPercent: -100,
        duration: 0.85,
        ease: "power4.inOut",
      },
      2.22
    );

    tl.to(
      shutterBottom,
      {
        yPercent: 100,
        duration: 0.85,
        ease: "power4.inOut",
      },
      2.22
    );

    // 5. Subtle Scale & Blur Reveal of Hero page
    tl.fromTo(
      "#main-nav, #home",
      { scale: 0.98, opacity: 0.6 },
      { scale: 1, opacity: 1, duration: 0.8, ease: "power3.out" },
      2.35
    );
  }

  // Initialize on DOM load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", runEditorialPreloader);
  } else {
    runEditorialPreloader();
  }
</script>
