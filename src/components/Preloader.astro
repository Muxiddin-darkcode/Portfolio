---
// Futuristik Kiber Conic Loader (Kengaytirilgan va boyitilgan versiya)
---

<div
  id="preloader"
  class="fixed inset-0 z-[99999] flex items-center justify-center bg-[#040404] select-none pointer-events-auto"
>
  <!-- Yumshoq nozik fon nuri (Ambient Mint Glow) -->
  <div class="absolute w-[450px] h-[450px] rounded-full bg-[radial-gradient(circle,_rgba(78,237,184,0.12)_0%,_transparent_65%)] blur-3xl pointer-events-none"></div>

  <!-- Markaziy kiber blok -->
  <div id="preloader-box" class="relative z-10 flex flex-col items-center space-y-5 px-4">
    
    <!-- Kiber Spinner va Orbital Konteyner -->
    <div class="relative w-28 h-28 flex items-center justify-center">
      
      <!-- 1. Tashqi teskari aylanuvchi nozik orbital HUD halqasi -->
      <div class="absolute inset-0 rounded-full border border-dashed border-[#4EEDB8]/30 animate-spin-reverse pointer-events-none"></div>
      
      <!-- 2. Tashqi 4 ta kiber yo'naltiruvchi burchak belgilari (HUD Ticks) -->
      <span class="absolute -top-1 left-1/2 -translate-x-1/2 w-2 h-1 bg-[#4EEDB8] shadow-[0_0_8px_#4EEDB8]"></span>
      <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-1 bg-[#4EEDB8] shadow-[0_0_8px_#4EEDB8]"></span>
      <span class="absolute top-1/2 -left-1 -translate-y-1/2 w-1 h-2 bg-[#4EEDB8] shadow-[0_0_8px_#4EEDB8]"></span>
      <span class="absolute top-1/2 -right-1 -translate-y-1/2 w-1 h-2 bg-[#4EEDB8] shadow-[0_0_8px_#4EEDB8]"></span>

      <!-- 3. Siz bergan asosiy Conic Mask Spinner (Neon gradient va jilo bilan boyitilgan) -->
      <div class="cyber-conic-loader"></div>

      <!-- 4. Markazdagi real-vaqt kiber foiz hisoblagichi (0% -> 100%) -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <span id="preloader-num" class="font-mono text-base font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-white via-[#4EEDB8] to-[#5FFEC4] tracking-tight">0%</span>
      </div>

    </div>

    <!-- Brend Ismi -->
    <div class="flex flex-col items-center space-y-3 text-center">
      <div class="flex items-center gap-2">
        <span class="text-xl sm:text-2xl font-extrabold font-mono text-white tracking-widest leading-none">
          MUXIDDIN<span class="text-transparent bg-clip-text bg-gradient-to-r from-[#4EEDB8] to-[#5FFEC4]">.DEV</span>
        </span>
      </div>

      <!-- Silliq Neon Progress Bar va Kiber To'lqinlar (Data Stream Wave Animation) -->
      <div class="flex flex-col items-center space-y-2.5">
        <!-- Progress chizig'i (0% dan 100% gacha silliq to'ladi) -->
        <div class="relative w-44 sm:w-52 h-[2.5px] bg-white/[0.08] rounded-full overflow-hidden">
          <div
            id="preloader-bar"
            class="h-full rounded-full bg-gradient-to-r from-[#00F5A0] via-[#4EEDB8] to-[#5FFEC4] shadow-[0_0_12px_#4EEDB8] w-0"
          ></div>
        </div>

        <!-- Ritmik to'lqinlanuvchi neon ekvalayzer chiziqchalari (Frequency Stream) -->
        <div class="flex items-center gap-1.5 h-3">
          <span class="w-[2px] h-full bg-[#4EEDB8] rounded-full animate-pulse-bar" style="animation-delay: 0ms"></span>
          <span class="w-[2px] h-full bg-[#5FFEC4] rounded-full animate-pulse-bar" style="animation-delay: 150ms"></span>
          <span class="w-[2px] h-full bg-[#00F5A0] rounded-full animate-pulse-bar" style="animation-delay: 300ms"></span>
          <span class="w-[2px] h-full bg-[#4EEDB8] rounded-full animate-pulse-bar" style="animation-delay: 450ms"></span>
          <span class="w-[2px] h-full bg-[#5FFEC4] rounded-full animate-pulse-bar" style="animation-delay: 200ms"></span>
          <span class="w-[2px] h-full bg-[#00F5A0] rounded-full animate-pulse-bar" style="animation-delay: 350ms"></span>
          <span class="w-[2px] h-full bg-[#4EEDB8] rounded-full animate-pulse-bar" style="animation-delay: 100ms"></span>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* Conic Mask Spinner - boyitilgan neon kiber varianti */
  .cyber-conic-loader {
    width: 66px;
    padding: 7px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 5%, #25b09b 40%, #4EEDB8 70%, #5FFEC4 90%, #ffffff 100%);
    --_m: 
      conic-gradient(#0000 10%, #000),
      linear-gradient(#000 0 0) content-box;
    -webkit-mask: var(--_m);
            mask: var(--_m);
    -webkit-mask-composite: source-out;
            mask-composite: subtract;
    animation: conicSpin 0.95s infinite linear;
    filter: drop-shadow(0 0 12px rgba(78, 237, 184, 0.65));
  }

  @keyframes conicSpin {
    to {
      transform: rotate(1turn);
    }
  }

  .animate-spin-reverse {
    animation: spinReverse 10s infinite linear;
  }

  @keyframes spinReverse {
    to {
      transform: rotate(-1turn);
    }
  }

  /* Ritmik to'lqinlanuvchi ekvalayzer animatsiyasi */
  @keyframes pulseBar {
    0%, 100% {
      transform: scaleY(0.2);
      opacity: 0.35;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
      box-shadow: 0 0 8px #4EEDB8;
    }
  }

  .animate-pulse-bar {
    animation: pulseBar 0.9s ease-in-out infinite;
    transform-origin: center;
  }
</style>

<script>
  import gsap from "gsap";

  function initConicPreloader() {
    const preloader = document.getElementById("preloader");
    const num = document.getElementById("preloader-num");
    const bar = document.getElementById("preloader-bar");
    const box = document.getElementById("preloader-box");

    if (!preloader || !num || !bar || !box) return;

    // Sahifa aylanishini vaqtincha to'xtatish
    document.body.style.overflow = "hidden";

    const counter = { val: 0 };

    // Silliq va toza hisoblash (1.15 soniya)
    gsap.to(counter, {
      val: 100,
      duration: 1.15,
      ease: "power2.inOut",
      onUpdate: () => {
        const v = Math.round(counter.val);
        num.textContent = `${v}%`;
        bar.style.width = `${v}%`;
      },
      onComplete: () => {
        // 100% bo'lgach kiber yadro mayin yo'qoladi
        gsap.to(box, {
          opacity: 0,
          scale: 0.92,
          duration: 0.22,
          ease: "power2.in",
        });

        gsap.to(preloader, {
          opacity: 0,
          duration: 0.35,
          delay: 0.08,
          ease: "power2.out",
          onComplete: () => {
            preloader.style.display = "none";
            document.body.style.overflow = "";
            window.dispatchEvent(new CustomEvent("preloader:complete"));
          },
        });
      },
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initConicPreloader);
  } else {
    initConicPreloader();
  }
</script>
