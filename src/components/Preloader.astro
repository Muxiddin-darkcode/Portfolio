---
// Preloader component for modern cyber/portfolio loading screen (2.3s)
---

<div
  id="preloader-overlay"
  class="fixed inset-0 z-[99999] bg-[#030306] flex flex-col items-center justify-center select-none overflow-hidden transition-all duration-700 ease-out"
  aria-hidden="false"
>
  <!-- Background High-Tech Atmospheric Glows -->
  <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-orange-600/15 blur-[120px] pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-amber-500/15 blur-[120px] pointer-events-none"></div>
  
  <!-- Subtle Grid Pattern Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,107,0,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,107,0,0.04)_1px,transparent_1px)] bg-[size:36px_36px] pointer-events-none [mask-image:radial-gradient(ellipse_at_center,black_50%,transparent_90%)]"></div>

  <!-- Centerpiece Container -->
  <div class="relative z-10 flex flex-col items-center max-w-sm sm:max-w-md w-full px-6">
    
    <!-- Animated Cyber Hexagon Badge with Concentric Neon Rings -->
    <div class="relative w-28 h-28 sm:w-32 sm:h-32 mb-8 flex items-center justify-center">
      
      <!-- Outer Rotating Segmented Neon Ring -->
      <div class="absolute inset-0 rounded-full border-2 border-dashed border-orange-500/40 animate-spin [animation-duration:12s]"></div>
      
      <!-- Middle Reverse Pulsing Ring -->
      <div class="absolute inset-2 rounded-full border border-amber-400/30 animate-spin [animation-duration:8s] [animation-direction:reverse]"></div>
      
      <!-- Inner Glowing Core Disc -->
      <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-gradient-to-tr from-[#0a0a10] via-[#12121e] to-[#1c1c2e] border border-orange-500/40 shadow-[0_0_40px_rgba(255,107,0,0.35)] flex flex-col items-center justify-center overflow-hidden group">
        
        <!-- Glowing scanline beam -->
        <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-orange-400/20 to-transparent animate-pulse pointer-events-none"></div>
        
        <!-- Monogram -->
        <span class="font-extrabold text-2xl sm:text-3xl text-transparent bg-clip-text bg-gradient-to-tr from-white via-amber-200 to-orange-400 font-mono tracking-tighter">
          SM
        </span>
        <span class="text-[9px] font-mono uppercase tracking-widest text-orange-400/80 font-bold -mt-0.5">
          v2.0
        </span>
      </div>

      <!-- Glowing Particle Dots -->
      <span class="absolute top-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-orange-400 shadow-[0_0_8px_#ff6b00]"></span>
      <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-amber-300 shadow-[0_0_8px_#f59e0b]"></span>
    </div>

    <!-- Digital Large Counter (0% -> 100%) -->
    <div class="flex items-baseline gap-1 mb-3">
      <span
        id="preloader-counter"
        class="font-mono text-5xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white via-amber-300 to-orange-400 drop-shadow-[0_4px_25px_rgba(255,107,0,0.4)]"
      >
        0
      </span>
      <span class="font-mono text-2xl sm:text-3xl font-bold text-orange-400/90">%</span>
    </div>

    <!-- High-Tech Segmented Progress Bar -->
    <div class="w-full bg-[#0d0d16] border border-orange-500/25 rounded-full p-1 shadow-[inset_0_2px_8px_rgba(0,0,0,0.8)] mb-4">
      <div
        id="preloader-bar"
        class="h-2 rounded-full bg-gradient-to-r from-orange-600 via-amber-400 to-yellow-300 shadow-[0_0_15px_rgba(255,184,0,0.7)] transition-all duration-75 ease-out w-0 relative overflow-hidden"
      >
        <!-- Shimmer line on bar -->
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent animate-[shimmer_1.2s_infinite]"></div>
      </div>
    </div>

    <!-- Cycling System Boot Logs -->
    <div class="flex flex-col items-center text-center space-y-1">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span
          id="preloader-status-text"
          class="font-mono text-xs sm:text-sm font-semibold text-slate-300 tracking-wide"
        >
          Tizim tayyorlanmoqda...
        </span>
      </div>
      <p class="font-mono text-[11px] text-slate-500 uppercase tracking-widest">
        Shamsiddinov Muxiddin &middot; IT Portfolio
      </p>
    </div>

    <!-- Bottom Skip / Ready Ticks -->
    <div class="flex items-center gap-3 mt-6 text-[10px] font-mono text-slate-500">
      <span class="flex items-center gap-1 text-orange-400/80">
        <span class="w-1 h-1 rounded-full bg-orange-400"></span> 3D Matrix
      </span>
      <span>&bull;</span>
      <span class="flex items-center gap-1 text-amber-300/80">
        <span class="w-1 h-1 rounded-full bg-amber-400"></span> 24+ Tech Stack
      </span>
      <span>&bull;</span>
      <span class="flex items-center gap-1 text-emerald-400/80">
        <span class="w-1 h-1 rounded-full bg-emerald-400"></span> Verified
      </span>
    </div>

  </div>
</div>

<script is:inline>
  (function initPreloader() {
    const overlay = document.getElementById("preloader-overlay");
    const counterEl = document.getElementById("preloader-counter");
    const barEl = document.getElementById("preloader-bar");
    const statusTextEl = document.getElementById("preloader-status-text");

    if (!overlay || !counterEl || !barEl || !statusTextEl) return;

    // Prevent body scroll during initial loading
    document.body.style.overflow = "hidden";

    const messages = [
      "Tizim tayyorlanmoqda...",
      "Full-stack modullar yuklanmoqda...",
      "Python & Aiogram 3 yadrosi ishga tushmoqda...",
      "3D Tech Galereyasi yaratilmoqda...",
      "Shaxsiy portfolio tayyor!"
    ];

    const totalDuration = 2300; // ~2.3 seconds
    const startTime = performance.now();

    function update() {
      const now = performance.now();
      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / totalDuration);

      // Smooth cubic easing for high-tech feeling
      const easedProgress = Math.pow(progress, 0.85);
      const currentPercent = Math.floor(easedProgress * 100);

      counterEl.textContent = currentPercent.toString();
      barEl.style.width = currentPercent + "%";

      // Update message steps
      const msgIndex = Math.min(
        messages.length - 1,
        Math.floor(progress * messages.length)
      );
      statusTextEl.textContent = messages[msgIndex];

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        // Complete!
        counterEl.textContent = "100";
        barEl.style.width = "100%";
        statusTextEl.textContent = "Xush kelibsiz!";

        setTimeout(() => {
          overlay.style.opacity = "0";
          overlay.style.transform = "translateY(-100%) scale(1.02)";
          overlay.style.pointerEvents = "none";
          document.body.style.overflow = "";

          setTimeout(() => {
            overlay.setAttribute("aria-hidden", "true");
            overlay.style.display = "none";
            // Dispatch event for smooth reveal of animations
            window.dispatchEvent(new CustomEvent("preloader:complete"));
          }, 700);
        }, 150);
      }
    }

    requestAnimationFrame(update);
  })();
</script>
