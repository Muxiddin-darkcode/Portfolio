---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

interface Project {
  id: string;
  title: string;
  category: "Tayyor" | "Jarayonda" | "G‘oya";
  type: string;
  desc: string;
  image: string;
  tags: string[];
  github?: string;
  demo?: string;
}

