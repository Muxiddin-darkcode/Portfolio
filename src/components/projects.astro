---

<section id="projects" class="py-16 sm:py-24 border-t border-orange-500/15 text-white relative">
  <div class="space-y-10">
    
    <!-- Clean Section Header & Responsive Filter Bar (GSAP Reveal) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 section-header">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/25 text-orange-400 text-xs font-semibold tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-orange-400 animate-pulse"></span>
          <span>Amaliy ishlar</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
          Loyihalarim
        </h2>
        <p class="text-sm sm:text-base text-slate-400 max-w-xl">
          Amaliy veb-portallar, asinxron Telegram botlar va IT ta'lim platformalari.
        </p>
      </div>

      <!-- Human, Clean Filter Tabs (Magnetic & Smooth Animated) -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0 no-scrollbar w-full sm:w-auto flex-nowrap">
        <button
          class="project-filter-btn magnetic-item px-4 py-2 rounded-xl border border-orange-500 bg-orange-500 text-stone-950 font-bold text-xs sm:text-sm shadow-md shadow-orange-500/30 transition-all cursor-pointer whitespace-nowrap flex-shrink-0"
          data-filter="all"
        >
          Barchasi (11)
        </button>
        <button
          class="project-filter-btn magnetic-item px-4 py-2 rounded-xl border border-orange-500/20 bg-[#09090f] text-slate-300 hover:text-white hover:border-orange-500/50 text-xs sm:text-sm font-semibold transition-all cursor-pointer whitespace-nowrap flex-shrink-0"
          data-filter="Tayyor"
        >
          Tayyor loyihalar (4)
        </button>
        <button
          class="project-filter-btn magnetic-item px-4 py-2 rounded-xl border border-orange-500/20 bg-[#09090f] text-slate-300 hover:text-white hover:border-orange-500/50 text-xs sm:text-sm font-semibold transition-all cursor-pointer whitespace-nowrap flex-shrink-0"
          data-filter="Jarayonda"
        >
          Jarayonda (3)
        </button>
        <button
          class="project-filter-btn magnetic-item px-4 py-2 rounded-xl border border-orange-500/20 bg-[#09090f] text-slate-300 hover:text-white hover:border-orange-500/50 text-xs sm:text-sm font-semibold transition-all cursor-pointer whitespace-nowrap flex-shrink-0"
          data-filter="G‘oya"
        >
          G‘oyalar (4)
        </button>
      </div>
    </div>

    <!-- Projects Grid (GSAP Staggered Reveal + 3D Tilt Cards) -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        projects.map((project) => (
          <div
            class="project-card reveal-card tilt-card cyber-card rounded-2xl overflow-hidden flex flex-col justify-between bg-[#08080e]/90 border-orange-500/20 group hover:border-orange-500/50 transition-all shadow-lg"
            data-category={project.category}
          >
            <!-- Card Image -->
            <div class="relative h-44 overflow-hidden border-b border-orange-500/15">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#08080e] via-transparent to-black/30"></div>
              
              <!-- Top Category Badge -->
              <div class="absolute top-3 left-3 right-3 flex items-center justify-between text-xs">
                <span class="px-2.5 py-1 rounded-lg bg-black/80 backdrop-blur-md border border-orange-500/30 text-amber-300 font-semibold text-[11px]">
                  {project.type}
                </span>
                
                {project.category === "Tayyor" && (
                  <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 backdrop-blur-md border border-emerald-500/40 text-emerald-300 font-bold text-[11px] flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Tayyor
                  </span>
                )}
                {project.category === "Jarayonda" && (
                  <span class="px-2.5 py-1 rounded-lg bg-orange-500/20 backdrop-blur-md border border-orange-500/40 text-orange-300 font-bold text-[11px] flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>
                    Jarayonda
                  </span>
                )}
                {project.category === "G‘oya" && (
                  <span class="px-2.5 py-1 rounded-lg bg-amber-500/20 backdrop-blur-md border border-amber-500/40 text-amber-300 font-bold text-[11px]">
                    G‘oya
                  </span>
                )}
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-amber-300 transition-colors">
                  {project.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans">
                  {project.desc}
                </p>
              </div>

              <!-- Tech Tags & Magnetic Action Link -->
              <div class="space-y-3 pt-3 border-t border-orange-500/15">
                <div class="flex flex-wrap gap-1.5 text-[11px]">
                  {project.tags.map((tag) => (
                    <span class="px-2.5 py-0.5 rounded-md bg-[#0e0e16] border border-orange-500/15 text-slate-300 font-medium">
                      {tag}
                    </span>
                  ))}
                </div>

                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="magnetic-btn btn-shine inline-flex items-center justify-between w-full p-2.5 rounded-xl bg-[#0e0e16] border border-orange-500/20 hover:border-orange-500/60 hover:bg-orange-500/10 text-xs font-semibold text-orange-300 hover:text-white transition-all cursor-pointer"
                  >
                    <span class="magnetic-text flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
                        <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/>
                      </svg>
                      <span>GitHub'da ko‘rish</span>
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                      <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- GitHub Profile Banner with Magnetic Button -->
    <div class="cyber-card reveal-card p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-orange-500/10 via-[#08080e] to-amber-500/10 border-orange-500/30 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="text-base sm:text-lg font-bold text-white">
          Barcha repozitoriylar va ochiq kodli loyihalar
        </h3>
        <p class="text-xs sm:text-sm text-slate-400">
          GitHub profilimda yangi loyihalar va kodlar bazasi bilan tanishing.
        </p>
      </div>

      <a
        href="https://github.com/Muxiddin-darkcode"
        target="_blank"
        rel="noopener noreferrer"
        class="magnetic-btn btn-shine inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 text-stone-950 font-bold text-xs sm:text-sm shadow-md shadow-orange-500/25 hover:shadow-orange-500/40 whitespace-nowrap cursor-pointer"
      >
        <span class="magnetic-text flex items-center gap-2">
          <span>GitHub Profil</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/>
          </svg>
        </span>
      </a>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";

  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".project-filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".project-card");

  const activeClasses = ["bg-orange-500", "text-stone-950", "border-orange-500", "shadow-md"];
  const inactiveClasses = ["bg-[#09090f]", "text-slate-300", "border-orange-500/20", "hover:border-orange-500/50", "hover:text-white"];

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;

      // Update active button state
      filterBtns.forEach((b) => {
        b.classList.remove(...activeClasses);
        b.classList.add(...inactiveClasses);
      });
      btn.classList.add(...activeClasses);
      btn.classList.remove(...inactiveClasses);

      // Filter cards with GSAP smooth stagger
      cards.forEach((card) => {
        const category = card.dataset.category;
        const matches = filter === "all" || category === filter;
        if (matches) {
          card.style.display = "flex";
          gsap.fromTo(
            card,
            { opacity: 0, scale: 0.94, y: 15 },
            { opacity: 1, scale: 1, y: 0, duration: 0.35, ease: "power2.out" }
          );
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>
