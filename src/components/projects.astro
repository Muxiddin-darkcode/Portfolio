    type: "Veb-Katalog",
    desc: "O‘zbekiston foydalanuvchilari uchun foydali dasturiy vositalarni to‘plash, taqqoslash va qulay topish imkonini beruvchi axborot platformasi.",
    image: `${baseUrl}/images/ikmt_web.jpg`,
    tags: ["Web Directory", "Python", "Frontend", "Search UI"],
    github: "https://github.com/Muxiddin-darkcode",
  },
  {
    id: "metro-news",
    title: "METRO NEWS",
    category: "G‘oya",
    type: "Telegram Bot G‘oyasi",
    desc: "Metro va transport yangiliklari, harakat jadvallari va muhim e'lonlarni yo‘lovchilarga tezkor yetkazishga qaratilgan bot konsepsiyasi.",
    image: `${baseUrl}/images/ikmt_bot.jpg`,
    tags: ["Python", "Telegram Bot", "News API", "Urban Tech"],
    github: "https://github.com/Muxiddin-darkcode",
  },
  {
    id: "energy-downloader",
    title: "Energy Downloader",
    category: "G‘oya",
    type: "Universal Bot G‘oyasi",
    desc: "Turli media materiallari va videolarni yuqori sifatda qulay yuklab olish jarayonini soddalashtirishga mo‘ljallangan bot loyihasi.",
    image: `${baseUrl}/images/ikmt_bot.jpg`,
    tags: ["Python", "Media Downloader", "Async Bot"],
    github: "https://github.com/Muxiddin-darkcode",
  },
  {
    id: "ebook-audio-bot",
    title: "Elektron & Audio Kitoblar Boti",
