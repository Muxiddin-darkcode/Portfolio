---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

interface Project {
  id: string;
  title: string;
  category: "Tayyor" | "Jarayonda" | "G‘oya";
  type: string;
  desc: string;
  image: string;
  tags: string[];
  github?: string;
  demo?: string;
}

const projects: Project[] = [
  {
    id: "ikmt-web",
    title: "Sirdaryo IKMT Rasmiy Veb-Sayti",
    category: "Tayyor",
    type: "Veb-Portal",
    desc: "Ta’lim muassasasi faoliyatini internetda yoritish, yangiliklar va e’lonlar, ta’lim yo‘nalishlari, rahbariyat va xodimlar sahifalari hamda administrator paneli.",
    image: `${baseUrl}/images/ikmt_web.jpg`,
    tags: ["HTML5", "CSS3", "JavaScript", "Bootstrap", "Admin Panel"],
    github: "https://github.com/Muxiddin-darkcode",
  },
  {
    id: "ikmt-bot",
    title: "Sirdaryo IKMT Raqamli Assistenti",
    category: "Tayyor",
    type: "Telegram Bot",
    desc: "Texnikum foydalanuvchilariga yordam beruvchi aqlli bot: menyu, rol tanlash, institut haqidagi ma'lumotlar, dars jadvali va ob-havo xizmati integratsiyasi.",
    image: `${baseUrl}/images/ikmt_bot.jpg`,
    tags: ["Python", "Aiogram 3", "SQLite", "Telegram API", "Weather API"],
    github: "https://github.com/Muxiddin-darkcode",
  },
  {
    id: "my-slades",
    title: "My Slades",
    category: "Tayyor",
    type: "Web / Shablonlar",
    desc: "PowerPoint taqdimotlari va zamonaviy slayd shablonlari bilan ishlashni soddalashtirishga, taqdimotlarni chiroyli formatda yaratishga qaratilgan loyiha.",
    image: `${baseUrl}/images/my_slades.jpg`,
    tags: ["Frontend", "JavaScript", "Presentation UI", "GitHub"],
    github: "https://github.com/Muxiddin-darkcode/My-Slades.git",
  },
  {
    id: "dastur-top",
    title: "Dastur Top Bot",
    category: "Tayyor",
    type: "Telegram Bot",
    desc: "Foydali kompyuter va mobil dasturlarni topish, ularning vazifasi hamda xususiyatlarini foydalanuvchilarga qulay yetkazib berish boti.",
    image: `${baseUrl}/images/ikmt_bot.jpg`,
    tags: ["Python", "Aiogram", "Database", "Software Catalog"],
    github: "https://github.com/Muxiddin-darkcode",
  },
  {
    id: "konkurs-qil",
    title: "Konkurs Qil Bot",
    category: "Jarayonda",
    type: "Telegram Bot",
    desc: "Telegram kanallari va guruhlarida avtomatlashtirilgan shaffof tanlovlar va konkurslarni tashkil etish, interfeys va ijtimoiy targ‘ibot imkoniyatlari.",
    image: `${baseUrl}/images/ikmt_bot.jpg`,
    tags: ["Python", "Aiogram 3", "SQLite", "Contest Logic"],
    github: "https://github.com/Muxiddin-darkcode",
  },
  {
    id: "gdpi-togarak",
    title: "GDPI To‘garak Platformasi",
    category: "Jarayonda",
    type: "EdTech Veb Platforma",
    desc: "Guliston davlat pedagogika instituti to‘garaklari faoliyatini raqamlashtirish: administrator paneli, o‘qituvchi va talaba kabinetlari, SQLite bazasi va API.",
    image: `${baseUrl}/images/gdpi_platform.jpg`,
    tags: ["Python", "Web App", "SQLite", "API Integratsiya", "EdTech"],
    github: "https://github.com/Muxiddin-darkcode",
  },
  {
    id: "soft-uz",
    title: "SoftUz Loyihasi",
